# Solyra desktop shell: the Quickshell (QML) menu bar, dock, notch, Spotlight,
# Control Center, notifications, Mission Control, snap layouts and lock
# screen, plus the Hyprland configuration, wallpapers and default look.
pkgname=solyra-shell
pkgver=0.1.0
pkgrel=1
pkgdesc="Solyra desktop shell for Hyprland (Quickshell QML)"
arch=(any)
url="https://github.com/PupppyLoverr/Infi-AI"
license=(GPL-3.0-only)
depends=(hyprland quickshell qt6-declarative qt6-svg qt6-5compat grim slurp wl-clipboard wtype
         brightnessctl networkmanager bluez-utils pipewire wireplumber playerctl libnotify upower
         inter-font ttf-jetbrains-mono curl inotify-tools adwaita-cursors)
optdepends=('power-profiles-daemon: Energy Mode in the Battery menu' 'hyprsunset: Night Shift' 'wf-recorder: screen recording' 'satty: screenshot markup' 'qt6-multimedia: Notchface camera preview' 'tesseract: Text from Screen (OCR)'
            'flatpak: install Flathub apps via solyra-app' 'distrobox: run Ubuntu/Fedora/Arch containers' 'fuse2: run AppImages'
            'claude-code: Ask Claude in Spotlight' 'codex: Ask ChatGPT in Spotlight')
source=()
_repo="${SOLYRA_REPO:-$startdir/../..}"

check() {
  # Every QML file must at least parse.
  if command -v qmllint >/dev/null; then
    for f in "$_repo"/shell/qs/*.qml; do qmllint "$f" 2>&1 | grep -iE "syntax error" && return 1; done
  fi
  return 0
}

package() {
  install -d "$pkgdir/etc/xdg/quickshell" "$pkgdir/etc/skel/.config/hypr" "$pkgdir/usr/share/backgrounds/solyra" "$pkgdir/etc/skel/.config/solyra" "$pkgdir/usr/share/fonts/TTF" "$pkgdir/etc/fonts/conf.d"
  cp -r "$_repo/shell/qs/." "$pkgdir/etc/xdg/quickshell/"
  install -Dm644 "$_repo"/assets/fonts/geist/Geist*.ttf -t "$pkgdir/usr/share/fonts/TTF/"
  install -Dm644 "$_repo/assets/fonts/60-solyra-geist.conf" "$pkgdir/etc/fonts/conf.d/60-solyra-geist.conf"
  install -Dm644 "$_repo/assets/fonts/geist/Geist-OFL.txt" "$pkgdir/usr/share/licenses/$pkgname/Geist-OFL.txt"
  install -Dm644 "$_repo/shell/hypr/hyprland.lua" "$pkgdir/etc/skel/.config/hypr/hyprland.lua"
  install -Dm644 /dev/null "$pkgdir/etc/skel/.config/solyra/hypr-local.lua"
  install -Dm644 "$_repo"/assets/wallpapers/*-1920x1080.png "$_repo"/assets/wallpapers/solyra-dusk-1920x1200.png "$_repo"/assets/wallpapers/*-4k.jpg -t "$pkgdir/usr/share/backgrounds/solyra/"
  install -Dm644 "$_repo/assets/wallpapers/twilight-skyline-4k.jpg" "$pkgdir/etc/skel/.config/solyra/wallpaper.jpg"
  install -Dm644 "$_repo/assets/wallpapers/solyra-dusk-1920x1200.png" "$pkgdir/etc/skel/.config/solyra/wallpaper.png"
  install -Dm755 "$_repo/iso/airootfs/usr/local/bin/solyra-app" "$pkgdir/usr/bin/solyra-app"
  install -Dm755 "$_repo/iso/airootfs/usr/local/bin/solyra-control" "$pkgdir/usr/bin/solyra-control"
  install -Dm644 "$_repo/THIRD_PARTY.md" "$pkgdir/usr/share/licenses/$pkgname/THIRD_PARTY.md"
}
