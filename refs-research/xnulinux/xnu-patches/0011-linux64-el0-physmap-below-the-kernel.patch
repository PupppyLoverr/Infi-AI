-	if ((va >= gVirtBase) && (va < (gVirtBase + real_phys_size))) {
+	/*
+	 * The kernel's static range (the image and the boot data, which the host maps at the kernel's base) is linear
+	 * from gVirtBase; the rest of that range is the heap's. Before arm_vm_init has set static_memory_end nothing
+	 * else is mapped there.
+	 */
+	if ((va >= gVirtBase) && (va < (static_memory_end ? static_memory_end : (gVirtBase + real_phys_size)))) {
 		return (pmap_paddr_t)(va - gVirtBase) + gPhysBase;
 	}
 	return 0;
@@ -1658,19 +1663,35 @@ arm_vm_physmap_init(boot_args *args)
 
 	if (linux64_el0) {
 		/*
-		 * Pure EL0 host: reuse the permanent 2 MiB linear aperture
-		 * [gVirtBase, gVirtBase + real_phys_size) directly as physmap so
-		 * large-RAM boots (>= 6 GiB) do not duplicate physmap VA space.
+		 * Pure EL0 host: the physical aperture is the host's permanent linear mapping of all of DRAM at
+		 * LINUX64_EL0_APERTURE_VA (physmap_base), below the kernel, so that it takes none of the heap's room
+		 * whatever the DRAM size (it was at the kernel's base, and above about 8 GiB the kernel map's ranges no
+		 * longer fit after it). The table has what the kernel's static range does not: the memory before the
+		 * image and everything after the boot data. The image and the boot data keep their addresses at the
+		 * kernel's base, where the host maps them a second time.
 		 */
-		if (segLOWEST > gVirtBase) {
-			arm_vm_page_granular_RWNX(gVirtBase, segLOWEST - gVirtBase,
-			    ARM64_GRANULE_ALLOW_BLOCK | ARM64_GRANULE_ALLOW_HINT);
+		const vm_offset_t top_of_kernel_data = gVirtBase + (args->topOfKernelData - gPhysBase);
+		const pmap_paddr_t el0_pa[2] = { gPhysBase, args->topOfKernelData };
+		const vm_size_t el0_len[2] = { segLOWEST - gVirtBase, real_avail_end - args->topOfKernelData };
+		unsigned int n = 0;
+
+		arm_vm_page_granular_RWNX(end_kern, top_of_kernel_data - end_kern,
+		    ARM64_GRANULE_ALLOW_BLOCK | ARM64_GRANULE_ALLOW_HINT); /* Device Tree, RAM Disk (if present), bootArgs */
+		for (unsigned int i = 0; i < 2; i++) {
+			if (el0_len[i] == 0) {
+				continue;
+			}
+			temp_ptov_table[n].pa = el0_pa[i];
+			temp_ptov_table[n].va = physmap_base + (el0_pa[i] - gPhysBase);
+			temp_ptov_table[n].len = round_page(el0_len[i]);
+			/* pa_offset as arm_vm_physmap_slide has it: the aperture's address less the one at the kernel's base */
+			arm_vm_page_granular_prot(temp_ptov_table[n].va, temp_ptov_table[n].len,
+			    temp_ptov_table[n].va - (el0_pa[i] - gPhysBase + gVirtBase), 1, AP_RWNA, 1,
+			    ARM64_GRANULE_ALLOW_BLOCK | ARM64_GRANULE_ALLOW_HINT, ARM64_PAGE_UNGUARDED);
+			assert((temp_ptov_table[n].va + temp_ptov_table[n].len) <= physmap_end);
+			n++;
 		}
-		arm_vm_page_granular_RWNX(end_kern, (gVirtBase + real_phys_size) - end_kern,
-		    ARM64_GRANULE_ALLOW_BLOCK | ARM64_GRANULE_ALLOW_HINT);
-		temp_ptov_table[0].pa = gPhysBase;
-		temp_ptov_table[0].va = gVirtBase;
-		temp_ptov_table[0].len = real_phys_size;
+		qsort(temp_ptov_table, PTOV_TABLE_SIZE, sizeof(temp_ptov_table[0]), cmp_ptov_entries);
 		memcpy(ptov_table, temp_ptov_table, sizeof(ptov_table));
 		return;
 	}
