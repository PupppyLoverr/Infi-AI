From: xnulinux
Subject: [PATCH] linux64: on a pure EL0 host too, the physical aperture goes below the kernel

0009 moved the physical aperture below the kernel for a host that runs XNU at EL1, and left a pure EL0 host as it
was: there the aperture is not XNU's to place, it is the host's permanent linear mapping of all of DRAM, and xnu.ko
put that at the kernel's base, so it took its room from the 48 GiB after the kernel's link address and the kernel
map's ranges did not fit above about 8 GiB of DRAM.

xnu.ko now puts that mapping at LINUX64_EL0_APERTURE_VA (linux64_abi.h, version 5), which is VM_MIN_KERNEL_ADDRESS, and
maps the image and the boot data (up to topOfKernelData, rounded up to 2 MiB) a second time at the kernel's base,
where the kernel is linked to run. Here:

- physmap_base is that address and physmap_end is real_phys_size above it; the kernel's static range ends with the
  boot data again (rounded up to a twig), and the heap follows it.
- The table of the aperture has what the static range does not, as on every other system: the memory before the image
  and everything after the boot data. Its second entry is set before the first page table page is allocated, because
  that memory is no longer mapped at the kernel's base.
- The addresses the host maps for good, which XNU's tables only describe and never mirror to the host, are now two
  ranges, the aperture and the kernel's static range: linux64_el0_va_permanent.
- ml_static_mfree keeps freeing the static range on this host, as it always did there.
---
--- a/osfmk/arm/pmap/pmap.c
+++ b/osfmk/arm/pmap/pmap.c
@@ -662,6 +662,18 @@ pte_is_xs(const pt_attr_t *pt_attr, pt_entry_t pte)
 	arm64_sync_tlb(strong);                                                                               \
 }
 
+/*
+ * Pure EL0 host: the kernel addresses the host maps for good, and XNU's tables only describe: the physical aperture
+ * (all of DRAM, in 2 MiB frames) and the kernel's static range at its base (the image and the boot data). The two
+ * were one range while the aperture began at the kernel's base.
+ */
+static inline bool
+linux64_el0_va_permanent(vm_map_address_t va)
+{
+	return (physmap_end > physmap_base && va >= physmap_base && va < physmap_end) ||
+	       (va >= gVirtBase && va < static_memory_end);
+}
+
 static inline void
 linux64_el0_mirror_pte(pmap_t pmap, vm_map_address_t va, pt_entry_t pte, uint64_t size)
 {
@@ -670,7 +682,7 @@ linux64_el0_mirror_pte(pmap_t pmap, vm_map_address_t va, pt_entry_t pte, uint64_
 	}
 	__builtin_arm_dmb(DMB_ISH);
 	if (pmap == kernel_pmap) {
-		if (physmap_end > physmap_base && va >= physmap_base && va < physmap_end) {
+		if (linux64_el0_va_permanent(va)) {
 			return;
 		}
 		struct linux64_map_req req = { .va = va, .size = size };
@@ -741,7 +753,7 @@ pmap_el0_kmap_range_supported(vm_map_address_t va, pmap_paddr_t pa, vm_map_size_
 	for (vm_map_size_t off = 0; off < size; off += PAGE_SIZE) {
 		vm_map_address_t cva = va + off;
 		pmap_paddr_t cpa = pa + off;
-		if (physmap_end > physmap_base && cva >= physmap_base && cva < physmap_end) {
+		if (linux64_el0_va_permanent(cva)) {
 			continue;
 		}
 		if (!pa_valid(cpa)) {
@@ -759,7 +771,7 @@ pmap_el0_kmap_pte_supported(pmap_t pmap, vm_map_address_t va)
 	if (!linux64_el0 || pmap != kernel_pmap) {
 		return true;
 	}
-	if (physmap_end > physmap_base && va >= physmap_base && va < physmap_end) {
+	if (linux64_el0_va_permanent(va)) {
 		return true;
 	}
 	pn = pmap_find_phys(pmap, va);
@@ -786,7 +798,7 @@ pmap_el0_kmap_pte_ready(pmap_t pmap, vm_map_address_t va, vm_prot_t req_prot)
 	if (!pte_is_valid(pte)) {
 		return false;
 	}
-	if (!(physmap_end > physmap_base && va >= physmap_base && va < physmap_end) &&
+	if (!(linux64_el0_va_permanent(va)) &&
 	    !pa_valid(pte_to_pa(pte))) {
 		return false;
 	}
@@ -7784,7 +7796,7 @@ static bool
 linux64_el0_kpage_check_locked(vm_offset_t addr, bool require_write, pmap_paddr_t *pa_out)
 {
 	vm_map_address_t va = (vm_map_address_t)(addr & ~0xfffULL);
-	bool in_physmap = (physmap_end > physmap_base && va >= physmap_base && va < physmap_end);
+	bool in_physmap = (linux64_el0_va_permanent(va));
 	tt_entry_t *ttep = pmap_tte(kernel_pmap, va);
 	if (!ttep) {
 		return false;
--- a/osfmk/arm64/arm_vm_init.c
+++ b/osfmk/arm64/arm_vm_init.c
@@ -414,7 +414,12 @@ linux64_el0_ptov_vtop(vm_offset_t va)
 			return (pmap_paddr_t)(va - ptov_table[i].va) + ptov_table[i].pa;
 		}
