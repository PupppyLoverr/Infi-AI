+#include <libkern/c++/OSKext.h>
+
+/*
+ * LINUX64 (xnulinux): a stand-in for AppleKeyStore's "AKSKernelServices" table, which AMFI requires (AKS_services()
+ * has no path without it). The entries AMFI calls are type-discriminated function pointers: 0x120 (disc 0x61fc,
+ * register for a state notification), 0x128 (0x146e, read state), 0x130 (0xd507, unregister). A hosted XNU has no
+ * keybag: the queries report unsupported, unregistering succeeds.
+ */
+#include <ptrauth.h>
+static int
+linux64_aks_unsupported(void)
+{
+	return kIOReturnUnsupported;
+}
+static int
+linux64_aks_ok(void)
+{
+	return 0;
+}
+static uintptr_t linux64_aks_table[0x40];
+
+
+/*
+ * LINUX64 (xnulinux): the stand-in IOAESAccelerator's AES operation (vtable +0x890, called by AppleImage4 with
+ * (src, dst, length, iv, direction, ...)). There is no device key to use: it copies src to dst ("encrypts" with the
+ * identity), which is all a hosted Image4 nonce store needs to stay consistent.
+ */
+extern "C" uint64_t kvtophys(vm_offset_t va);
+extern "C" void ml_phys_write_double_64(addr64_t paddr, unsigned long long data);
+static IOReturn
+linux64_aes_perform(IOService *self, IOMemoryDescriptor *src, IOMemoryDescriptor *dst, uint64_t len, void *iv, int dir,
+    void *a6, void *a7)
+{
+	(void)self; (void)iv; (void)dir; (void)a6; (void)a7;
+	if (!src || !dst || len > 65536) {
+		return kIOReturnBadArgument;
+	}
+	void *buf = IOMallocData((vm_size_t)len);
+	if (!buf) {
+		return kIOReturnNoMemory;
+	}
+	/* the descriptors come unprepared (a real engine prepares them for its DMA): wire them for the copy, each in its
+	 * own direction (AppleVirtualPlatformXART encrypts in place: one in-out descriptor as both, which a read-only
+	 * preparation would keep writeBytes from) */
+	IOReturn rs = src->prepare(), rd = (src == dst) ? kIOReturnSuccess : dst->prepare();
+	IOByteCount got = 0, put = 0;
+	if (rs == kIOReturnSuccess && rd == kIOReturnSuccess) {
+		got = src->readBytes(0, buf, (IOByteCount)len);
+		put = dst->writeBytes(0, buf, got);
+	}
+	if (rs == kIOReturnSuccess) {
+		src->complete();
+	}
+	if (rd == kIOReturnSuccess && src != dst) {
+		dst->complete();
+	}
+	IOFreeData(buf, (vm_size_t)len);
+	return (got == len && put == len) ? kIOReturnSuccess : kIOReturnIOError;
+}
+
+static void
+linux64_patch_aes_vtable(OSObject *aes)
+{
+	uintptr_t vt = (uintptr_t)ptrauth_auth_data(*(void **)aes, ptrauth_key_asda,
+	    ptrauth_blend_discriminator(aes, 0xcda1));
+	uintptr_t entry = vt + 0x890;
+	void *fn = ptrauth_strip((void *)&linux64_aes_perform, ptrauth_key_function_pointer);
+	uint64_t signed_fn = (uint64_t)ptrauth_sign_unauthenticated(fn, ptrauth_key_asia,
+	    ptrauth_blend_discriminator((void *)entry, 0x17dc));
+	uint64_t pa = kvtophys((vm_offset_t)entry);
+	if (pa) {
+		ml_phys_write_double_64((addr64_t)pa, signed_fn);
+		IOLog("LINUX64: IOAESAccelerator AES entry (vtable %p +0x890) is the hosted copy\n", (void *)vt);
+	}
+}
+
+static void
+linux64_register_stand_in(IOService *parent, IOService *s, const char *name)
+{
+	if (s && s->init()) {
+		s->setName(name);
+		if (s->attach(parent)) {
+			s->registerService();
+			IOLog("LINUX64: stand-in %s registered\n", name);
+		}
+	}
+	if (s) {
+		s->release();
+	}
+}
+static void *
+linux64_aks_services(void)
+{
+	if (!linux64_aks_table[0]) {
+		void *un = ptrauth_strip((void *)&linux64_aks_unsupported, ptrauth_key_function_pointer);
+		void *ok = ptrauth_strip((void *)&linux64_aks_ok, ptrauth_key_function_pointer);
+		for (unsigned i = 1; i < 0x40; i++) {
+			linux64_aks_table[i] = (uintptr_t)ptrauth_sign_unauthenticated(un, ptrauth_key_asia, 0);
+		}
+		linux64_aks_table[0x120 / 8] = (uintptr_t)ptrauth_sign_unauthenticated(un, ptrauth_key_asia, 0x61fc);
+		linux64_aks_table[0x128 / 8] = (uintptr_t)ptrauth_sign_unauthenticated(un, ptrauth_key_asia, 0x146e);
+		linux64_aks_table[0x130 / 8] = (uintptr_t)ptrauth_sign_unauthenticated(ok, ptrauth_key_asia, 0xd507);
+		linux64_aks_table[0] = (uintptr_t)ptrauth_sign_unauthenticated(un, ptrauth_key_asia, 0);
+	}
+	return linux64_aks_table;
+}
