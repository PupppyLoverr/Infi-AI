+dev_t
+mdevadd_host(void)
+{
+	uint64_t size = 0;
+	long bytes;
+	dev_t dev;
+	int i;
+
+	if (!linux64_hook) {
+		return -1;
+	}
+	mdev_host_call(995, (unsigned long)&size);
