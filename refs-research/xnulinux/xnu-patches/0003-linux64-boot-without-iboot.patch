 #include <security/audit/audit.h>
 #if CONFIG_MACF
 #include <security/mac_framework.h>
@@ -2525,6 +2540,32 @@ sys_dup2(proc_t p, struct dup2_args *uap, int32_t *retval)
 	return dup2(p, p_cred, uap->from, uap->to, retval);
 }
 
+/*
+ * LINUX64: dup3(from, to, flags), system call 149 in macOS 27's libsystem_kernel: dup2 that fails when from == to and
+ * takes O_CLOEXEC for the new descriptor.
+ */
+int
+sys_dup3(proc_t p, struct dup3_args *uap, int32_t *retval)
+{
+	kauth_cred_t p_cred = current_cached_proc_cred(p);
+	int error;
+
+	if ((uap->flags & ~O_CLOEXEC) || uap->from == uap->to) {
+		return EINVAL;
+	}
+	error = dup2(p, p_cred, uap->from, uap->to, retval);
+	if (error == 0 && (uap->flags & O_CLOEXEC)) {
+		struct fileproc *fp;
+
+		proc_fdlock(p);
+		if ((fp = fp_get_noref_locked(p, uap->to)) != NULL) {
+			fp->fp_flags |= FP_CLOEXEC;
+		}
+		proc_fdunlock(p);
+	}
+	return error;
+}
