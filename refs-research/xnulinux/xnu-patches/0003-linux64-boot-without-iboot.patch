+/* LINUX64: hosted with the amfi_get_out_of_my_way boot-arg, code signing lets any locally built code load (kern_mman.c too) */
+int linux64_amfi_off(void);
+int
+linux64_amfi_off(void)
+{
+	static int off = -1;
+	if (off < 0) {
+		int v = 0;
+		off = PE_parse_boot_argn("amfi_get_out_of_my_way", &v, sizeof(v)) && v != 0;
+	}
+	return off;
+}
