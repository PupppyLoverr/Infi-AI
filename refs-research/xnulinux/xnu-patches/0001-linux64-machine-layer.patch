+bool
+linux64_el0_sync_user_pte(pmap_t pmap, vm_offset_t far, uint64_t esr)
+{
+	if (!linux64_el0 || !pmap || pmap == kernel_pmap) {
+		return false;
+	}
+	uint64_t as = linux64_el0_ensure_as(pmap);
+	if (!as) {
+		return false;
+	}
+	uint64_t ufar = (uint64_t)((int64_t)(far << 8) >> 8);
+	if (ufar >= 0x0001000000000000ULL) {
+		return false;
+	}
+	vm_map_address_t va = (vm_map_address_t)(ufar & ~0xfffULL);
+	uint32_t ec = (uint32_t)((esr >> 26) & 0x3f);
+	bool is_exec = (ec == 0x20 || ec == 0x21);
+	bool is_write = (!is_exec) && ((esr & (1u << 6)) != 0) && ((esr & (1u << 8)) == 0);
+
+	pmap_lock(pmap, PMAP_LOCK_SHARED);
+	pt_entry_t *ptep = pmap_pte(pmap, va);
+	if (!ptep) {
+		pmap_unlock(pmap, PMAP_LOCK_SHARED);
+		return false;
+	}
+	pt_entry_t pte = ARM_PTE_EMPTY;
+	pmap_paddr_t pa = 0;
+	unsigned int pai = 0;
+	bool user_read = false, user_write = false, user_exec = false;
+	bool locked_pvh = false;
+	for (int retry = 0; retry < 4; retry++) {
+		pte = *(volatile pt_entry_t *)ptep;
+		if (!pte_is_valid(pte) || !(pte & ARM_PTE_AF)) {
+			pmap_unlock(pmap, PMAP_LOCK_SHARED);
+			return false;
+		}
+		uint64_t ap = pte & ARM_PTE_APMASK;
+		user_read = (ap == ARM_PTE_AP(AP_RORO) || ap == ARM_PTE_AP(AP_RWRW));
+		user_write = (ap == ARM_PTE_AP(AP_RWRW));
+		user_exec = !(pte & ARM_PTE_NX);
+		if (is_exec ? !user_exec : (is_write ? !user_write : !user_read)) {
+			pmap_unlock(pmap, PMAP_LOCK_SHARED);
+			return false;
+		}
+		pa = pte_to_pa(pte);
+		if (!pa_valid(pa)) {
+			pmap_unlock(pmap, PMAP_LOCK_SHARED);
+			return false;
+		}
+		pai = pa_index(pa);
+		pvh_lock(pai);
+		if (*(volatile pt_entry_t *)ptep == pte) {
+			locked_pvh = true;
+			break;
+		}
+		pvh_unlock(pai);
+	}
+	if (!locked_pvh) {
+		pmap_unlock(pmap, PMAP_LOCK_SHARED);
+		return false;
+	}
+
+	struct linux64_map_req req = {
+		.as_handle = as,
+		.va = va,
+		.pa = pa,
+		.size = 4096,
+		.prot = (user_read ? LINUX64_PROT_READ : 0) |
+		    (user_write ? LINUX64_PROT_WRITE : 0) |
+		    (user_exec ? LINUX64_PROT_EXEC : 0),
+	};
+	linux64_call(LINUX64_CALL_AS_MAP, &req);
+	pvh_unlock(pai);
+	pmap_unlock(pmap, PMAP_LOCK_SHARED);
+	return req.result > 0;
+}
