+static bool
+el0GrowOverwriteChunks(
+	struct linux64_el0_mem_entry_chunk **chunksIO,
+	size_t                              *capIO,
+	size_t                               need)
+{
+	if (need <= *capIO) {
+		return true;
+	}
+	size_t newCap = (*capIO == 0) ? 16 : *capIO;
+	while (newCap < need) {
+		if (os_mul_overflow(newCap, 2, &newCap)) {
+			return false;
+		}
+	}
+	struct linux64_el0_mem_entry_chunk *nb = IONew(struct linux64_el0_mem_entry_chunk, newCap);
+	if (nb == NULL) {
+		return false;
+	}
+	if (*chunksIO != NULL) {
+		bcopy(*chunksIO, nb, (*capIO) * sizeof(*nb));
+		IODelete(*chunksIO, struct linux64_el0_mem_entry_chunk, *capIO);
+	}
+	*chunksIO = nb;
+	*capIO = newCap;
+	return true;
+}
