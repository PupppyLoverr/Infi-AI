+static void
+el0_zap_unpin_saved(struct el0_zap_saved *s)
+{
+	if (s->pinned_pages == NULL || s->pinned_objs == NULL || s->pinned_count == 0) {
+		return;
+	}
+	for (size_t i = 0; i < s->pinned_count; i++) {
+		vm_page_t m = s->pinned_pages[i];
+		vm_object_t po = s->pinned_objs[i];
+		if (m != VM_PAGE_NULL && po != VM_OBJECT_NULL) {
+			s->pinned_pages[i] = VM_PAGE_NULL;
+			s->pinned_objs[i] = VM_OBJECT_NULL;
+			el0_zap_unpin_page(m, po);
+		}
+	}
+}
