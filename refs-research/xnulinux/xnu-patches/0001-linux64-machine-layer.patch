+static bool
+linux64_el0_lock_user_page(pmap_t pmap, vm_offset_t uaddr, bool write, pmap_paddr_t *pa_out, unsigned int *pai_out)
+{
+	if (!pmap || pmap == kernel_pmap) {
+		return false;
+	}
+	vm_map_address_t page_va = (vm_map_address_t)(uaddr & ~0xfffULL);
+	pmap_lock(pmap, PMAP_LOCK_SHARED);
+	pt_entry_t *ptep = pmap_pte(pmap, page_va);
+	if (!ptep) {
+		pmap_unlock(pmap, PMAP_LOCK_SHARED);
+		return false;
+	}
+	for (int retry = 0; retry < 4; retry++) {
+		pt_entry_t pte = *(volatile pt_entry_t *)ptep;
+		if (!pte_is_valid(pte) || !(pte & ARM_PTE_AF)) {
+			pmap_unlock(pmap, PMAP_LOCK_SHARED);
+			return false;
+		}
+		uint64_t ap = pte & ARM_PTE_APMASK;
+		if (write ? (ap != ARM_PTE_AP(AP_RWRW)) :
+		    (ap != ARM_PTE_AP(AP_RORO) && ap != ARM_PTE_AP(AP_RWRW))) {
+			pmap_unlock(pmap, PMAP_LOCK_SHARED);
+			return false;
+		}
+		pmap_paddr_t pa = pte_to_pa(pte);
+		if (!pa_valid(pa)) {
+			pmap_unlock(pmap, PMAP_LOCK_SHARED);
+			return false;
+		}
+		unsigned int pai = pa_index(pa);
+		pvh_lock(pai);
+		if (*(volatile pt_entry_t *)ptep == pte) {
+			*pa_out = pa + (uaddr & 0xfffULL);
+			*pai_out = pai;
+			return true;
+		}
+		pvh_unlock(pai);
+	}
+	pmap_unlock(pmap, PMAP_LOCK_SHARED);
+	return false;
+}
