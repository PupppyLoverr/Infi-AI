+bool
+linux64_el0_user_vtop(pmap_t pmap, vm_offset_t va, bool write, pmap_paddr_t *pa_out)
+{
+	if (!pmap || pmap == kernel_pmap) {
+		return false;
+	}
+	vm_map_address_t page_va = (vm_map_address_t)(va & ~0xfffULL);
+	pmap_lock(pmap, PMAP_LOCK_SHARED);
+	pt_entry_t *ptep = pmap_pte(pmap, page_va);
+	pt_entry_t pte = ptep ? *ptep : ARM_PTE_EMPTY;
+	pmap_unlock(pmap, PMAP_LOCK_SHARED);
+
+	if (!pte_is_valid(pte) || !(pte & ARM_PTE_AF)) {
+		return false;
+	}
+	uint64_t ap = pte & ARM_PTE_APMASK;
+	if (write) {
+		if (ap != ARM_PTE_AP(AP_RWRW)) {
+			return false;
+		}
+	} else {
+		if (ap != ARM_PTE_AP(AP_RORO) && ap != ARM_PTE_AP(AP_RWRW)) {
+			return false;
+		}
+	}
+	pmap_paddr_t pa = pte_to_pa(pte);
+	if (!pa_valid(pa)) {
+		return false;
+	}
+	*pa_out = pa + (va & 0xfffULL);
+	return true;
+}
