+				return kIOReturnNoMemory;
+			}
+			struct linux64_el0_mem_entry_chunk *c = &(*chunksIO)[*nchunksIO];
+			c->port = preEntry->entry;
+			c->offset = preEntryOffset;
+			c->size = preChunk;
+			c->map_size = entryMapSize;
+			c->prot = prot;
+			c->tag = tag;
+			c->return_data_addr = useDataAddr;
+			c->check_data_addr = true;
+			c->expected_data_addr = useDataAddr ? *curLogicalAddrIO : vm_map_trunc_page(*curLogicalAddrIO, mapMask);
+			c->cache_perm = memEntryCacheMode;
+			c->data_addr_out = 0;
+			(*nchunksIO)++;
+			*totalMapSizeIO = newTotal;
+			mach_vm_size_t chunkLogicalBytes = useDataAddr ? preChunk : (preChunk - prePageOffset);
+			if (os_add_overflow(*curLogicalAddrIO, chunkLogicalBytes, curLogicalAddrIO)) {
+				return kIOReturnBadArgument;
+			}
+			preRemain -= preChunk;
+			if (!preRemain) {
+				break;
+			}
+			if (chunkLogicalBytes > (mach_vm_size_t)INT64_MAX ||
+			    os_add_overflow(preOffset, (int64_t)chunkLogicalBytes, &preOffset)) {
+				return kIOReturnBadArgument;
+			}
+		}
+		prePageOffset = 0;
+		preEntry++;
+		preIdx++;
+	}
+
+	return kIOReturnSuccess;
+}
