+bool
+linux64_el0_atomic_op(pmap_t pmap, vm_offset_t uaddr, bool write, size_t width, uint64_t *val)
+{
+	pmap_paddr_t pa = 0;
+	unsigned int pai = 0;
+	if (!linux64_el0_lock_user_page(pmap, uaddr, write, &pa, &pai)) {
+		return false;
+	}
+	if (width == 4) {
+		if (write) {
+			__atomic_store_n((volatile uint32_t *)phystokv(pa), (uint32_t)*val, __ATOMIC_RELAXED);
+		} else {
+			*val = __atomic_load_n((volatile uint32_t *)phystokv(pa), __ATOMIC_RELAXED);
+		}
+	} else {
+		if (write) {
+			__atomic_store_n((volatile uint64_t *)phystokv(pa), *val, __ATOMIC_RELAXED);
+		} else {
+			*val = __atomic_load_n((volatile uint64_t *)phystokv(pa), __ATOMIC_RELAXED);
+		}
+	}
+	pvh_unlock(pai);
+	pmap_unlock(pmap, PMAP_LOCK_SHARED);
+	return true;
+}
