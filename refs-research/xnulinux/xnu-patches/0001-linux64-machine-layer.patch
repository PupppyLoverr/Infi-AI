+/*
+ * LINUX64 (xnulinux) diagnostics: print every thread's state, wait event, continuation and a few saved frames, when the
+ * host asks (LINUX64_CTR_DUMP_REQ). Called from the hosted idle path with interrupts off; the list is walked without its
+ * lock (another CPU may change it meanwhile: a diagnostic, not a consistent snapshot).
+ */
+void
+linux64_dump_threads(void)
+{
+	thread_t t;
+	int n = 0;
+	extern int proc_pid(struct proc *);
+	queue_iterate(&threads, t, thread_t, threads) {
+		if (++n > 400) {
+			break;
+		}
+		void *bp = get_bsdthreadtask_info(t);
+		if (bp == NULL || proc_pid((struct proc *)bp) == 0) {
+			/* the kernel's own threads: only those blocked with a saved stack (not parked on a continuation) */
+			if (t->continuation != NULL || t->kernel_stack == 0) {
+				continue;
+			}
+			kprintf("linux64 proc 0 kernel_task\n");
+		} else {
+			kprintf("linux64 proc %d %s\n", proc_pid((struct proc *)bp), proc_name_address((struct proc *)bp));
+		}
+		struct arm_kernel_saved_state *ss = (struct arm_kernel_saved_state *)(void *)t->machine.kstackptr;
+		uint64_t lr = 0, fp = 0;
+		if (ss != NULL && t->kernel_stack != 0) {
+			lr = ss->lr | 0xffffff8000000000ULL;
+			fp = ss->fp;
+		}
+		kprintf("linux64 thread %p tid %llu state 0x%x pri %d wait %p cont %p lr 0x%llx\n",
+		    t, t->thread_id, t->state, t->sched_pri, (void *)t->wait_event, (void *)t->continuation, lr);
+		for (int f = 0; f < 14 && fp != 0 && t->kernel_stack != 0 &&
+		    fp >= t->kernel_stack && fp < t->kernel_stack + kernel_stack_size; f++) {
+			uint64_t *frame = (uint64_t *)fp;
+			kprintf("linux64     frame 0x%llx\n", frame[1] | 0xffffff8000000000ULL);
+			fp = frame[0];
+		}
+	}
+}
