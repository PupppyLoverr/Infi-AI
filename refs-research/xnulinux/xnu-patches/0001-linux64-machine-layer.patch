+			}
+			if (entryMapSize == 0) {
+				return kIOReturnBadArgument;
+			}
+			mach_vm_size_t newTotal = 0;
+			if (os_add_overflow(*totalMapSizeIO, entryMapSize, &newTotal) ||
+			    newTotal > allowedMapSize) {
+				return kIOReturnNotAligned;
+			}
