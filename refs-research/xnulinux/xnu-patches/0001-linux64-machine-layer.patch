+
+static bool
+el0_atomic_segs_grow(
+	struct el0_atomic_seg **segs_p,
+	size_t                 *cap_p,
+	size_t                  need)
+{
+	if (need <= *cap_p) {
+		return true;
+	}
+	size_t new_cap = (*cap_p == 0) ? 16 : *cap_p;
+	while (new_cap < need) {
+		if (os_mul_overflow(new_cap, 2, &new_cap)) {
+			return false;
+		}
+	}
+	size_t new_bytes = 0;
+	if (os_mul_overflow(new_cap, sizeof(struct el0_atomic_seg), &new_bytes)) {
+		return false;
+	}
+	struct el0_atomic_seg *nb = kalloc_type(struct el0_atomic_seg, new_cap, Z_WAITOK | Z_ZERO);
+	if (nb == NULL) {
+		return false;
+	}
+	if (*segs_p != NULL) {
+		size_t old_bytes = (*cap_p) * sizeof(struct el0_atomic_seg);
+		bcopy(*segs_p, nb, old_bytes);
+		kfree_type(struct el0_atomic_seg, *cap_p, *segs_p);
+	}
+	*segs_p = nb;
+	*cap_p = new_cap;
+	return true;
+}
