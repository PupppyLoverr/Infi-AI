+bool
+vm_fault_el0_entry_va_skip_pte(
+	vm_map_t                map,
+	vm_map_entry_t          entry,
+	vm_map_offset_t         va)
+{
+	if (entry->is_sub_map) {
+		return false;
+	}
+	vm_object_t obj = VME_OBJECT(entry);
+	if (obj == VM_OBJECT_NULL) {
+		return false;
+	}
+	vm_object_offset_t off;
+	if (os_add_overflow(VME_OFFSET(entry), va - entry->vme_start, &off)) {
+		return false;
+	}
+	vm_object_lock_shared(obj);
+	if (obj->phys_contiguous) {
+		vm_object_unlock(obj);
+		return false;
+	}
+	for (;;) {
+		vm_page_t m = vm_page_lookup(obj, vm_object_trunc_page(off));
+		if (m != VM_PAGE_NULL) {
+			bool is_guard = vm_page_is_guard(m);
+			vm_object_unlock(obj);
+			return is_guard;
+		}
+		vm_object_t next = obj->shadow;
+		if (next == VM_OBJECT_NULL || os_add_overflow(off, obj->vo_shadow_offset, &off)) {
+			vm_object_unlock(obj);
+			return map->never_faults && entry->wired_count > 0;
+		}
+		vm_object_lock_shared(next);
+		vm_object_unlock(obj);
+		obj = next;
+	}
+}
+
+static inline bool
+vm_fault_el0_vo_copy_covers_page_locked(
+	vm_object_t             object,
+	vm_object_offset_t      page_off)
+{
+	vm_object_t copy_obj = object->vo_copy;
+	if (copy_obj == VM_OBJECT_NULL) {
+		return false;
+	}
+	if (page_off < copy_obj->vo_shadow_offset) {
+		return false;
+	}
+	return (page_off - copy_obj->vo_shadow_offset) < copy_obj->vo_size;
+}
+
+bool
+vm_fault_el0_never_faults_entry_supported(
+	vm_map_entry_t          entry,
+	vm_prot_t               req_prot)
+{
+	if (entry->is_sub_map || entry->wired_count == 0 || entry->needs_copy) {
+		return false;
+	}
+	vm_object_t obj = VME_OBJECT(entry);
+	if (obj == VM_OBJECT_NULL) {
+		return false;
+	}
+	vm_object_lock_shared(obj);
+	if (obj->phys_contiguous ||
+	    obj->shadow != VM_OBJECT_NULL ||
+	    obj->copy_strategy == MEMORY_OBJECT_COPY_SYMMETRIC) {
+		vm_object_unlock(obj);
+		return false;
+	}
+	vm_map_size_t entry_size = entry->vme_end - entry->vme_start;
+	for (vm_map_size_t off = 0; off < entry_size; off += PAGE_SIZE) {
+		vm_object_offset_t page_off;
+		if (os_add_overflow(VME_OFFSET(entry), off, &page_off)) {
+			vm_object_unlock(obj);
+			return false;
+		}
+		vm_page_t m = vm_page_lookup(obj, page_off);
+		if (m != VM_PAGE_NULL && !vm_page_is_guard(m)) {
+			if (vm_page_is_fictitious(m) ||
+			    m->vmp_wire_count == 0 ||
+			    (m->vmp_unusual && (m->vmp_error || m->vmp_restart || m->vmp_absent)) ||
+			    ((req_prot & VM_PROT_WRITE) &&
+			    vm_fault_el0_vo_copy_covers_page_locked(obj, page_off)) ||
+			    !pmap_el0_kmap_range_supported(entry->vme_start + off,
+			    (pmap_paddr_t)ptoa_64(VM_PAGE_GET_PHYS_PAGE(m)), PAGE_SIZE)) {
+				vm_object_unlock(obj);
+				return false;
+			}
+		}
+	}
+	vm_object_unlock(obj);
+	return true;
+}
+
+static kern_return_t
+vm_fault_el0_populate_never_faults_page(
+	vm_map_t                map,
+	vm_map_entry_t          entry,
+	vm_map_offset_t         va,
+	vm_prot_t               prot,
+	vm_tag_t                wire_tag)
+{
+	vm_object_t object = VME_OBJECT(entry);
+	vm_object_offset_t offset = (va - entry->vme_start) + VME_OFFSET(entry);
+	pmap_t pmap = map->pmap;
+	vm_map_size_t fault_page_size = MIN(VM_MAP_PAGE_SIZE(map), PAGE_SIZE);
+	vm_map_offset_t fault_phys_offset = offset - vm_object_trunc_page(offset);
+
+	for (;;) {
+		struct vm_object_fault_info fault_info = {
+			.user_tag = VME_ALIAS(entry),
+			.pmap_options = 0,
+			.fi_change_wiring = false,
+		};
+		if (entry->iokit_acct || (!entry->is_sub_map && !entry->use_pmap)) {
+			fault_info.pmap_options |= PMAP_OPTIONS_ALT_ACCT;
+		}
+		if (entry->vme_xnu_user_debug) {
+			fault_info.pmap_options |= PMAP_OPTIONS_XNU_USER_DEBUG;
+		}
+		if (entry->translated_allow_execute) {
+			fault_info.pmap_options |= PMAP_OPTIONS_TRANSLATED_ALLOW_EXECUTE;
+		}
+
+		vm_object_lock(object);
+		if (entry->needs_copy ||
+		    object->shadow != VM_OBJECT_NULL || object->phys_contiguous) {
+			vm_object_unlock(object);
+			return KERN_NOT_SUPPORTED;
+		}
+		vm_object_offset_t page_off = vm_object_trunc_page(offset);
+		vm_page_t m = vm_page_lookup(object, page_off);
+		if (m == VM_PAGE_NULL || vm_page_is_guard(m)) {
+			vm_object_unlock(object);
+			return KERN_SUCCESS;
+		}
+		if (m->vmp_busy) {
+			vm_page_sleep(object, m, THREAD_UNINT, LCK_SLEEP_UNLOCK);
+			continue;
+		}
+		if (vm_page_is_fictitious(m) ||
+		    m->vmp_wire_count == 0 ||
+		    (m->vmp_unusual && (m->vmp_error || m->vmp_restart || m->vmp_absent)) ||
+		    ((prot & VM_PROT_WRITE) &&
+		    vm_fault_el0_vo_copy_covers_page_locked(object, page_off))) {
+			vm_object_unlock(object);
+			return KERN_NOT_SUPPORTED;
+		}
+
+		vm_object_reference_locked(object);
+		vm_object_paging_begin(object);
+		m->vmp_busy = TRUE;
+
+		uint8_t object_lock_type = OBJECT_LOCK_EXCLUSIVE;
+		int type_of_fault = DBG_CACHE_HIT_FAULT;
+		bool page_sleep_needed = false;
+		bool need_retry = false;
+		kern_return_t kr = vm_fault_enter(m, pmap, va, fault_page_size,
+		    fault_phys_offset, prot, prot, TRUE, wire_tag, &fault_info,
+		    &need_retry, &type_of_fault, &object_lock_type, &page_sleep_needed);
+
+		if (need_retry) {
+			/*
+			 * NOWAIT pmap enter hit page-table or PV resource shortage.
+			 * Keep m->vmp_busy and paging_in_progress held, drop object
+			 * lock, and perform blocking pmap enter without NOWAIT.
+			 */
+			vm_prot_t enter_prot = prot;
+			vm_object_unlock(object);
+			kr = vm_fault_attempt_pmap_enter(pmap, va, fault_page_size,
+			    fault_phys_offset, m, &enter_prot, prot, prot, TRUE,
+			    fault_info.pmap_options);
+			vm_object_lock(object);
+		}
+
+		vm_page_wakeup_done(object, m);
+		vm_object_paging_end(object);
+		vm_object_unlock(object);
+		vm_object_deallocate(object);
+
+		if (!need_retry && page_sleep_needed) {
+			mutex_pause(0);
+			continue;
+		}
+		return kr;
+	}
+}
+
+kern_return_t
+vm_fault_el0_populate_wired_entry(
+	vm_map_t                map,
+	vm_map_entry_t          entry,
+	vm_prot_t               prot,
+	vm_tag_t                wire_tag,
+	vm_map_lock_ctx_t       vml_ctx)
+{
+	vm_map_offset_t         va;
+	vm_map_offset_t         end_addr = entry->vme_end;
+	kern_return_t           rc;
+	vm_map_size_t           effective_page_size;
+	pmap_t                  pmap = map->pmap;
+
+	if (entry->is_sub_map || VME_OBJECT(entry) == VM_OBJECT_NULL ||
+	    !(prot & (VM_PROT_READ | VM_PROT_WRITE))) {
+		return KERN_SUCCESS;
+	}
+	if (VME_OBJECT(entry)->phys_contiguous) {
+		return vm_fault_wire_resident_pages(map, entry, prot, wire_tag, NULL, vml_ctx);
+	}
+
+	effective_page_size = MIN(VM_MAP_PAGE_SIZE(map), PAGE_SIZE);
+	for (va = entry->vme_start;
+	    va < end_addr;
+	    va += effective_page_size) {
+		if (pmap_el0_kmap_pte_ready(pmap, va, prot) ||
+		    vm_fault_el0_entry_va_skip_pte(map, entry, va)) {
+			continue;
+		}
