+				return kIOReturnNotAligned;
+			}
+			mach_vm_size_t entryMapSize = 0;
+			if (useDataAddr) {
+				kern_return_t sErr = mach_memory_entry_map_size(
+				    preEntry->entry, map, preEntryOffset, preChunk, &entryMapSize);
+				if (KERN_SUCCESS != sErr) {
+					return sErr;
+				}
