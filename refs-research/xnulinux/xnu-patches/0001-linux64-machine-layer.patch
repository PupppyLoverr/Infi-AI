+static unsigned int
+pmap_el0_attrindx_to_wimg(unsigned int attrindx, pt_entry_t pte)
+{
+	if (attrindx == CACHE_ATTRINDX_DISABLE) {
+		return VM_WIMG_IO;
+	}
+#if HAS_FEAT_XS
+	if (attrindx == CACHE_ATTRINDX_DISABLE_XS) {
+		return VM_WIMG_IO;
+	}
+	if (attrindx == CACHE_ATTRINDX_POSTED_COMBINED_REORDERED_XS) {
+		return VM_WIMG_POSTED_COMBINED_REORDERED;
+	}
+#endif
+	if (attrindx == CACHE_ATTRINDX_POSTED) {
+		return VM_WIMG_POSTED;
+	}
+	if (attrindx == CACHE_ATTRINDX_POSTED_REORDERED) {
+		return VM_WIMG_POSTED_REORDERED;
+	}
+	if (attrindx == CACHE_ATTRINDX_POSTED_COMBINED_REORDERED) {
+		return VM_WIMG_POSTED_COMBINED_REORDERED;
+	}
+	if (attrindx == CACHE_ATTRINDX_WRITECOMB) {
+		return VM_WIMG_WCOMB;
+	}
+	if (attrindx == CACHE_ATTRINDX_WRITETHRU) {
+		return VM_WIMG_WTHRU;
+	}
+	if (attrindx == CACHE_ATTRINDX_WRITEBACK) {
+		if ((pte & ARM_PTE_SHMASK) == ARM_PTE_SH(SH_INNER_MEMORY)) {
+			return VM_WIMG_INNERWBACK;
+		}
+		return VM_WIMG_COPYBACK;
+	}
+	return VM_WIMG_USE_DEFAULT;
+}
+
+bool
+pmap_el0_wimg_supported(unsigned int wimg)
+{
+	return !linux64_el0 || wimg == VM_WIMG_DEFAULT ||
+	       wimg == VM_WIMG_COPYBACK || wimg == VM_WIMG_USE_DEFAULT;
+}
+
+kern_return_t
+pmap_el0_update_cache_mode(
+	pmap_t                  pmap,
+	vm_map_address_t        va,
+	unsigned int            wimg_flags,
+	bool                    use_default)
+{
+	pt_entry_t *ptep;
+	pt_entry_t pte;
+
+	if (!linux64_el0 || pmap != kernel_pmap) {
+		return KERN_INVALID_ARGUMENT;
+	}
+
+	pmap_lock(pmap, PMAP_LOCK_SHARED);
+	ptep = pmap_pte(pmap, va);
+	pte = ptep ? *ptep : ARM_PTE_EMPTY;
+	pmap_unlock(pmap, PMAP_LOCK_SHARED);
+
+	if (!pte_is_valid(pte)) {
+		return KERN_FAILURE;
+	}
+
+	pmap_paddr_t pa = pte_to_pa(pte);
+	if (!pa_valid(pa)) {
+		return KERN_NOT_SUPPORTED;
+	}
+	ppnum_t pn = atop(pa);
+#if HAS_MTE
+	if (pmap_is_tagged_page(pn)) {
+		return KERN_INVALID_ARGUMENT;
+	}
+#endif
+	unsigned int attr = use_default ? pmap_cache_attributes(pn) : wimg_flags;
+	if (!pmap_el0_wimg_supported(attr)) {
+		return KERN_NOT_SUPPORTED;
+	}
+	pmap_set_cache_attributes(pn, attr);
+	return KERN_SUCCESS;
+}
+
+bool
+pmap_el0_read_pte_snapshot(
+	pmap_t                  pmap,
+	vm_map_address_t        va,
+	uint64_t               *pte_out,
+	pmap_paddr_t           *pa_out,
+	bool                   *pa_is_valid_out)
+{
+	_Static_assert(sizeof(pt_entry_t) <= sizeof(uint64_t), "pt_entry_t must fit in uint64_t");
+	pt_entry_t *ptep;
+	pt_entry_t pte;
+
+	pmap_lock(pmap, PMAP_LOCK_SHARED);
+	ptep = pmap_pte(pmap, va);
+	pte = ptep ? *ptep : ARM_PTE_EMPTY;
+	pmap_unlock(pmap, PMAP_LOCK_SHARED);
+
+	if (pte_is_valid(pte)) {
+		pmap_paddr_t pa = pte_to_pa(pte);
+		if (pte_out != NULL) {
+			*pte_out = (uint64_t)pte;
+		}
+		if (pa_out != NULL) {
+			*pa_out = pa;
+		}
+		if (pa_is_valid_out != NULL) {
+			*pa_is_valid_out = pa_valid(pa);
+		}
+		return true;
+	}
+	if (pte_out != NULL) {
+		*pte_out = (uint64_t)ARM_PTE_EMPTY;
+	}
+	if (pa_out != NULL) {
+		*pa_out = 0;
+	}
+	if (pa_is_valid_out != NULL) {
+		*pa_is_valid_out = false;
+	}
+	return false;
+}
+
+bool
+pmap_el0_pte_restorable(
+	pmap_t                  pmap,
+	uint64_t                saved_pte_u64)
+{
+	pt_entry_t saved_pte = (pt_entry_t)saved_pte_u64;
+	if (!pte_is_valid(saved_pte)) {
+		return true;
+	}
+	if (pmap == kernel_pmap && !(saved_pte & ARM_PTE_PNX)) {
+#if DEVELOPMENT || DEBUG
+		if (!nx_enabled || !pmap->nx_enabled) {
+			return true;
+		}
+#endif
+		return false;
+	}
+	return true;
+}
+
+kern_return_t
+pmap_el0_restore_pte_snapshot(
+	pmap_t                  pmap,
+	vm_map_address_t        va,
+	uint64_t                saved_pte_u64)
+{
+	pt_entry_t saved_pte = (pt_entry_t)saved_pte_u64;
+	if (!pte_is_valid(saved_pte)) {
+		return KERN_SUCCESS;
+	}
+	pmap_paddr_t pa = pte_to_pa(saved_pte);
+	ppnum_t pn = atop(pa);
+	vm_prot_t prot = VM_PROT_READ;
+	if ((saved_pte & ARM_PTE_APMASK) == ARM_PTE_AP(AP_RWNA) ||
+	    (saved_pte & ARM_PTE_APMASK) == ARM_PTE_AP(AP_RWRW)) {
+		prot |= VM_PROT_WRITE;
+	}
+	unsigned int wimg = pa_valid(pa) ?
+	    pmap_cache_attributes(pn) :
+	    pmap_el0_attrindx_to_wimg(ARM_PTE_EXTRACT_ATTRINDX(saved_pte), saved_pte);
+	boolean_t wired = ((saved_pte & ARM_PTE_WIRED) != 0);
+	return pmap_enter_addr(pmap, va, pa, prot, VM_PROT_NONE, wimg, wired);
+}
+
+kern_return_t
+pmap_el0_kmap_txn_begin(
+	vm_map_address_t        va,
+	vm_map_size_t           size,
+	uint64_t               *handle_out)
+{
+	if (handle_out == NULL) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	*handle_out = 0;
+	if (!linux64_el0 || size == 0) {
+		return KERN_SUCCESS;
+	}
+	struct linux64_map_req req = {
+		.as_handle = 0,
+		.va = va,
+		.pa = 0,
+		.size = size,
+		.prot = LINUX64_KMAP_TXN_BEGIN,
+		.result = 0,
+	};
+	linux64_call(LINUX64_CALL_KMAP_TXN, &req);
+	if (req.result < 0) {
+		switch (req.result) {
+		case -12: /* -ENOMEM */
+			return KERN_RESOURCE_SHORTAGE;
+		case -16: /* -EBUSY */
+			return KERN_ABORTED;
+		case -22: /* -EINVAL */
+			return KERN_INVALID_ARGUMENT;
+		case -95: /* -EOPNOTSUPP */
+			return KERN_NOT_SUPPORTED;
+		default:
+			return KERN_FAILURE;
+		}
+	}
+	if (req.as_handle == 0) {
+		return KERN_FAILURE;
+	}
+	*handle_out = req.as_handle;
+	return KERN_SUCCESS;
+}
+
+void
+pmap_el0_kmap_txn_begin_restore(uint64_t handle)
+{
+	if (!linux64_el0 || handle == 0) {
+		return;
+	}
+	struct linux64_map_req req = {
+		.as_handle = handle,
+		.va = 0,
+		.pa = 0,
+		.size = 0,
+		.prot = LINUX64_KMAP_TXN_RESTORE,
+		.result = 0,
+	};
+	linux64_call(LINUX64_CALL_KMAP_TXN, &req);
+}
+
+void
+pmap_el0_kmap_txn_end(uint64_t handle)
+{
+	if (!linux64_el0 || handle == 0) {
+		return;
+	}
+	struct linux64_map_req req = {
+		.as_handle = handle,
+		.va = 0,
+		.pa = 0,
+		.size = 0,
+		.prot = LINUX64_KMAP_TXN_END,
+		.result = 0,
+	};
+	linux64_call(LINUX64_CALL_KMAP_TXN, &req);
+}
