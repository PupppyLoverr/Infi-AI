+static bool
+el0_object_range_supported(
+	vm_object_t             object,
+	vm_object_offset_t      offset,
+	vm_map_size_t           size,
+	vm_map_offset_t         va,
+	bool                    allow_obj_wimg_override,
+	bool                    allow_device_pager_wimg)
+{
+	if (object == VM_OBJECT_NULL || size == 0 ||
+	    is_kernel_object(object) || object == compressor_object) {
+		return true;
+	}
+	vm_object_lock_shared(object);
+	bool is_device_pager = (object->pager != MEMORY_OBJECT_NULL &&
+	    is_device_pager_ops(object->pager->mo_pager_ops));
+	bool wimg_ok = allow_obj_wimg_override || pmap_el0_wimg_supported(object->wimg_bits) ||
+	    (allow_device_pager_wimg && is_device_pager);
+	if (!wimg_ok) {
+		vm_object_unlock(object);
+		return false;
+	}
+	bool ok = true;
+	if (object->phys_contiguous) {
+		if (!(object->private && object->pager_created && !object->vo_el0_populated)) {
+			vm_map_offset_t pa_base;
+			if (os_add_overflow((vm_map_offset_t)object->vo_shadow_offset,
+			    offset, &pa_base) ||
+			    !pmap_el0_kmap_range_supported(va, (pmap_paddr_t)pa_base, size)) {
+				ok = false;
+			}
+		}
+	} else if (object->private) {
+		for (vm_map_size_t off = 0; off < size; off += PAGE_SIZE) {
+			vm_object_offset_t page_off;
+			if (os_add_overflow(offset, object->paging_offset, &page_off) ||
+			    os_add_overflow(page_off, off, &page_off)) {
+				ok = false;
+				break;
+			}
+			vm_page_t m = vm_page_lookup(object, page_off);
+			if (m != VM_PAGE_NULL &&
+			    !pmap_el0_kmap_range_supported(va + off,
+			    (pmap_paddr_t)ptoa_64(VM_PAGE_GET_PHYS_PAGE(m)), PAGE_SIZE)) {
+				ok = false;
+				break;
+			}
+		}
+	}
+	vm_object_unlock(object);
+	return ok;
+}
 
