+bool
+linux64_el0_copyio_chunk(pmap_t pmap, vm_offset_t uaddr, bool write, void *bounce, size_t max_len, size_t *out_len)
+{
+	pmap_paddr_t pa = 0;
+	unsigned int pai = 0;
+	if (!linux64_el0_lock_user_page(pmap, uaddr, write, &pa, &pai)) {
+		return false;
+	}
+	size_t off = (size_t)(uaddr & 0xfffULL);
+	size_t chunk = 4096 - off;
+	if (chunk > max_len) {
+		chunk = max_len;
+	}
+	if (write) {
+		bcopy(bounce, (void *)phystokv(pa), chunk);
+	} else {
+		bcopy((const void *)phystokv(pa), bounce, chunk);
+	}
+	pvh_unlock(pai);
+	pmap_unlock(pmap, PMAP_LOCK_SHARED);
+	*out_len = chunk;
+	return true;
+}
