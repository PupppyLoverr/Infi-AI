+		mach_vm_size_t nextLen = 0;
+		mach_vm_size_t rrem = offset;
+		if (gmd->_task) {
+			if (!gmd->_rangesCount) {
+				return kIOReturnBadArgument;
+			}
+			uint32_t rangeIdx = 0;
+			for (rangeIdx = 0; rangeIdx < gmd->_rangesCount; rangeIdx++) {
+				getAddrLenForInd(nextAddr, nextLen, type, gmd->_ranges, rangeIdx, gmd->_task);
+				if (rrem < nextLen) {
+					break;
+				}
+				rrem -= nextLen;
+			}
+			if (rrem >= nextLen) {
+				return kIOReturnBadArgument;
+			}
+			nextAddr += rrem;
