+			}
+		} else {
+			rc = vm_fault_wire_fast(map, va, prot, wire_tag, entry, pmap, va, NULL);
+			if (rc != KERN_SUCCESS) {
+				struct vm_object_fault_info fault_info = {
+					.interruptible = THREAD_UNINT,
+					.behavior = VM_BEHAVIOR_SEQUENTIAL,
+					.fi_change_wiring = false,
+				};
+				if (os_sub_overflow(end_addr, va, &fault_info.cluster_size)) {
+					fault_info.cluster_size = UPL_SIZE_MAX;
+				}
+				rc = vm_fault_internal(map, va, prot, wire_tag,
+				    pmap, va, NULL, &fault_info, vml_ctx);
+				if (rc != KERN_SUCCESS) {
+					return rc;
+				}
+			}
+		}
+		if (pmap == kernel_pmap && !pmap_el0_kmap_pte_ready(pmap, va, prot) &&
+		    !vm_fault_el0_entry_va_skip_pte(map, entry, va)) {
+			return KERN_NOT_SUPPORTED;
+		}
+	}
+	return KERN_SUCCESS;
+}
