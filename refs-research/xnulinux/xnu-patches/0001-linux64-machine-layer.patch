+	while (newCap < need) {
+		if (os_mul_overflow(newCap, 2, &newCap)) {
+			return false;
+		}
+	}
+	struct linux64_el0_pending_pager *nb = IONew(struct linux64_el0_pending_pager, newCap);
+	if (nb == NULL) {
+		return false;
+	}
+	if (*pagersIO != NULL) {
+		bcopy(*pagersIO, nb, (*capIO) * sizeof(struct linux64_el0_pending_pager));
+		IODelete(*pagersIO, struct linux64_el0_pending_pager, *capIO);
+	}
+	*pagersIO = nb;
+	*capIO = newCap;
+	return true;
