+static void
+el0_zap_unpin_page(vm_page_t m, vm_object_t orig_obj)
+{
+	for (;;) {
+		vm_page_lock_queues();
+		vm_object_t cur_obj = VM_PAGE_OBJECT(m);
+		if (cur_obj == VM_OBJECT_NULL) {
+			vm_page_unlock_queues();
+			mutex_pause(0);
+			continue;
+		}
+		if (!vm_object_lock_try_scan(cur_obj)) {
+			vm_page_unlock_queues();
+			mutex_pause(0);
+			continue;
+		}
+		if (VM_PAGE_OBJECT(m) != cur_obj) {
+			vm_object_unlock(cur_obj);
+			vm_page_unlock_queues();
+			continue;
+		}
+		vm_page_unwire(m, TRUE);
+		vm_page_unlock_queues();
+		vm_object_unlock(cur_obj);
+		break;
+	}
+	vm_object_deallocate(orig_obj);
