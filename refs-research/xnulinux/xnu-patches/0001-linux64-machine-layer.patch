+static bool
+linux64_el0_kpage_check_locked(vm_offset_t addr, bool require_write, pmap_paddr_t *pa_out)
+{
+	vm_map_address_t va = (vm_map_address_t)(addr & ~0xfffULL);
+	bool in_physmap = (physmap_end > physmap_base && va >= physmap_base && va < physmap_end);
+	tt_entry_t *ttep = pmap_tte(kernel_pmap, va);
+	if (!ttep) {
+		return false;
+	}
+	tt_entry_t tte = *ttep;
+	uint64_t ap;
+	pmap_paddr_t pa = 0;
+	if ((tte & (ARM_TTE_VALID | ARM_TTE_TYPE_MASK)) == (ARM_TTE_VALID | ARM_TTE_TYPE_BLOCK)) {
+		if (!in_physmap) {
+			return false;
+		}
+		ap = tte & ARM_PTE_APMASK;
+	} else if (tte_is_valid_table(tte)) {
+		pt_entry_t *ptep = pmap_pte(kernel_pmap, va);
+		if (!ptep) {
+			return false;
+		}
+		pt_entry_t pte = os_atomic_load(ptep, relaxed);
+		if (!pte_is_valid(pte)) {
+			return false;
+		}
+		ap = pte & ARM_PTE_APMASK;
+		pa = pte_to_pa(pte);
+		if (!in_physmap && !pa_valid(pa)) {
+			return false;
+		}
+	} else {
+		return false;
+	}
+	if (require_write && ap != ARM_PTE_AP(AP_RWNA) && ap != ARM_PTE_AP(AP_RWRW)) {
+		return false;
+	}
+	if (pa_out) {
+		*pa_out = pa;
+	}
+	return true;
+}
