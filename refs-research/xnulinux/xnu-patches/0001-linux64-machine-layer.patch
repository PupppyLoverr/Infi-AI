+static kern_return_t
+el0_zap_save_entry(vm_map_zap_t zap, vm_map_t map, vm_map_entry_t entry)
+{
+	struct el0_zap_saved *s = kalloc_type(struct el0_zap_saved, Z_WAITOK | Z_ZERO);
+	if (s == NULL) {
+		return KERN_RESOURCE_SHORTAGE;
+	}
+	s->entry = entry;
+	s->map = map;
+	s->had_autowire = (entry->vme_el0_autowire != 0);
+	s->had_iokit_acct = (entry->iokit_acct != 0);
+	s->had_use_pmap = (entry->use_pmap != 0);
+
+	vm_object_t entry_obj = entry->is_sub_map ? VM_OBJECT_NULL : VME_OBJECT(entry);
+	if (!entry->is_sub_map && !entry->vme_kernel_object && entry_obj != compressor_object) {
+		vm_map_size_t eff_pgsz = MIN(VM_MAP_PAGE_SIZE(map), PAGE_SIZE);
+		uint64_t npages = (entry->vme_end - entry->vme_start) / eff_pgsz;
+		if (npages > 0) {
+			size_t ptes_bytes = 0;
+			if (npages > SIZE_MAX || os_mul_overflow(npages, sizeof(uint64_t), &ptes_bytes)) {
+				kfree_type(struct el0_zap_saved, s);
+				return KERN_RESOURCE_SHORTAGE;
+			}
+			uint64_t *ptes = kalloc_data(ptes_bytes, Z_WAITOK | Z_ZERO);
+			if (ptes == NULL) {
+				kfree_type(struct el0_zap_saved, s);
+				return KERN_RESOURCE_SHORTAGE;
+			}
+			bool need_pin = (!s->had_autowire &&
+			    entry_obj != VM_OBJECT_NULL && !entry_obj->phys_contiguous);
+			vm_page_t *pinned_pages = NULL;
+			vm_object_t *pinned_objs = NULL;
+			size_t pinned_count = 0;
+			if (need_pin) {
+				pinned_count = (size_t)npages;
+				pinned_pages = kalloc_type(vm_page_t, pinned_count, Z_WAITOK | Z_ZERO);
+				pinned_objs = kalloc_type(vm_object_t, pinned_count, Z_WAITOK | Z_ZERO);
+				if (pinned_pages == NULL || pinned_objs == NULL) {
+					if (pinned_pages != NULL) {
+						kfree_type(vm_page_t, pinned_count, pinned_pages);
+					}
+					if (pinned_objs != NULL) {
+						kfree_type(vm_object_t, pinned_count, pinned_objs);
+					}
+					kfree_data(ptes, ptes_bytes);
+					kfree_type(struct el0_zap_saved, s);
+					return KERN_RESOURCE_SHORTAGE;
+				}
+			}
+			s->npages = npages;
+			s->saved_ptes = ptes;
+			s->ptes_bytes = ptes_bytes;
+			s->pinned_pages = pinned_pages;
+			s->pinned_objs = pinned_objs;
+			s->pinned_count = pinned_count;
+
+			kern_return_t fail_kr = KERN_SUCCESS;
+			for (uint64_t i = 0; i < npages && fail_kr == KERN_SUCCESS; i++) {
+				vm_map_offset_t va = entry->vme_start + ((vm_map_offset_t)i * eff_pgsz);
+				bool page_done = false;
+
+				for (int attempt = 0; attempt < 3 && !page_done && fail_kr == KERN_SUCCESS; attempt++) {
+					uint64_t pte = 0;
+					pmap_paddr_t pa = 0;
+					bool pa_ok = false;
+
+					if (!pmap_el0_read_pte_snapshot(map->pmap, va, &pte, &pa, &pa_ok)) {
+						ptes[i] = 0;
+						page_done = true;
+						break;
+					}
+					if (!pmap_el0_pte_restorable(map->pmap, pte)) {
+						fail_kr = KERN_PROTECTION_FAILURE;
+						break;
+					}
+					if (!pa_ok || s->had_autowire ||
+					    (entry_obj != VM_OBJECT_NULL && entry_obj->phys_contiguous)) {
+						ptes[i] = pte;
+						s->has_saved_ptes = true;
+						page_done = true;
+						break;
+					}
+					if (entry_obj == VM_OBJECT_NULL) {
+						fail_kr = KERN_NOT_SUPPORTED;
+						break;
+					}
+
+					ppnum_t target_pn = atop(pa);
+					vm_object_offset_t cur_off = VME_OFFSET(entry) + ((vm_object_offset_t)i * eff_pgsz);
+					vm_object_t cur_obj = entry_obj;
+					vm_page_t pinned_m = VM_PAGE_NULL;
+					vm_object_t pinned_o = VM_OBJECT_NULL;
+					bool page_pinned_or_private = false;
+
+					vm_object_lock(cur_obj);
+					while (cur_obj != VM_OBJECT_NULL) {
+						vm_page_t m = vm_page_lookup(cur_obj, cur_off);
+						if (m != VM_PAGE_NULL) {
+							if (VM_PAGE_GET_PHYS_PAGE(m) == target_pn) {
+								if (vm_page_is_private(m)) {
+									page_pinned_or_private = true;
+								} else if (!vm_page_is_fictitious(m) &&
+								    !m->vmp_gobbled &&
+								    !m->vmp_absent &&
+								    !m->vmp_error) {
+									if (m->vmp_wire_count >= MAX_WIRE_COUNT) {
+										fail_kr = KERN_RESOURCE_SHORTAGE;
+									} else {
+										vm_page_lock_queues();
+										vm_page_wire(m, VM_KERN_MEMORY_OSFMK, FALSE);
+										vm_page_unlock_queues();
+										vm_object_reference_locked(cur_obj);
+										pinned_m = m;
+										pinned_o = cur_obj;
+										page_pinned_or_private = true;
+									}
+								}
+							}
+							vm_object_unlock(cur_obj);
+							break;
+						}
+						vm_object_t next_shadow = cur_obj->shadow;
+						if (next_shadow == VM_OBJECT_NULL ||
+						    os_add_overflow(cur_off, cur_obj->vo_shadow_offset, &cur_off)) {
+							vm_object_unlock(cur_obj);
+							break;
+						}
+						vm_object_lock(next_shadow);
+						vm_object_unlock(cur_obj);
+						cur_obj = next_shadow;
+					}
+					if (fail_kr != KERN_SUCCESS) {
+						break;
+					}
+
+					uint64_t re_pte = 0;
+					pmap_paddr_t re_pa = 0;
+					bool re_ok = false;
+					bool re_valid = pmap_el0_read_pte_snapshot(map->pmap, va, &re_pte, &re_pa, &re_ok);
+					if (!re_valid) {
+						if (pinned_m != VM_PAGE_NULL) {
+							el0_zap_unpin_page(pinned_m, pinned_o);
+						}
+						ptes[i] = 0;
+						page_done = true;
+						break;
+					}
+					if (page_pinned_or_private && re_ok && re_pa == pa &&
+					    pmap_el0_pte_restorable(map->pmap, re_pte)) {
+						if (pinned_m != VM_PAGE_NULL) {
+							pinned_pages[i] = pinned_m;
+							pinned_objs[i] = pinned_o;
+						}
+						ptes[i] = re_pte;
+						s->has_saved_ptes = true;
+						page_done = true;
+						break;
+					}
+					if (pinned_m != VM_PAGE_NULL) {
+						el0_zap_unpin_page(pinned_m, pinned_o);
+					}
+				}
+				if (fail_kr == KERN_SUCCESS && !page_done) {
+					fail_kr = KERN_ABORTED;
+				}
+			}
+			if (fail_kr != KERN_SUCCESS) {
+				el0_zap_unpin_saved(s);
+				if (s->pinned_pages != NULL) {
+					kfree_type(vm_page_t, s->pinned_count, s->pinned_pages);
+				}
+				if (s->pinned_objs != NULL) {
+					kfree_type(vm_object_t, s->pinned_count, s->pinned_objs);
+				}
+				kfree_data(s->saved_ptes, s->ptes_bytes);
+				kfree_type(struct el0_zap_saved, s);
+				return fail_kr;
+			}
+			if (!s->has_saved_ptes) {
+				el0_zap_unpin_saved(s);
+				if (s->pinned_pages != NULL) {
+					kfree_type(vm_page_t, s->pinned_count, s->pinned_pages);
+					s->pinned_pages = NULL;
+				}
+				if (s->pinned_objs != NULL) {
+					kfree_type(vm_object_t, s->pinned_count, s->pinned_objs);
+					s->pinned_objs = NULL;
+				}
+				s->pinned_count = 0;
+				kfree_data(s->saved_ptes, s->ptes_bytes);
+				s->saved_ptes = NULL;
+				s->ptes_bytes = 0;
+				s->npages = 0;
+			}
+		}
+	}
+	s->next = NULL;
+	*zap->el0_saved_tail = s;
+	zap->el0_saved_tail = &s->next;
+	return KERN_SUCCESS;
+}
+
+static void
+el0_zap_free_saved(vm_map_zap_t zap)
+{
+	while (zap->el0_saved_head != NULL) {
+		struct el0_zap_saved *s = zap->el0_saved_head;
+		zap->el0_saved_head = s->next;
+		el0_zap_unpin_saved(s);
