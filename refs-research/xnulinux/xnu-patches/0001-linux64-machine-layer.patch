+kern_return_t
+vm_map_el0_set_cache_mode(
+	vm_map_t                map,
+	mach_vm_address_t       va,
+	unsigned int            wimg_flags,
+	bool                    use_default)
+{
+	if (!linux64_el0 || map == VM_MAP_NULL || map->pmap != kernel_pmap) {
+		return KERN_INVALID_ARGUMENT;
+	}
+	vm_map_offset_t page_va = vm_map_trunc_page(va, VM_MAP_PAGE_MASK(map));
+	VM_MAP_FIND_LOCK_CTX_DECLARE(ctx);
+	vm_map_t orig_map = map;
+	kern_return_t kr = vm_map_find_entry_ex_locked(ctx, &orig_map, page_va,
+	    VMRL_FIND_EX_DEFAULT);
+	if (kr != KERN_SUCCESS) {
+		return kr;
+	}
+	vm_map_t locked_map = vm_map_lock_ctx_get_map(ctx);
+	vm_map_entry_t entry = vm_map_found_entry_get_entry(ctx);
+	if (VME_IS_SENTINEL(entry) || entry->is_sub_map ||
+	    VME_OBJECT(entry) == VM_OBJECT_NULL) {
+		vm_map_found_entry_ex_unlock(ctx, &orig_map);
+		return KERN_INVALID_ARGUMENT;
+	}
+	kr = pmap_el0_update_cache_mode(locked_map->pmap, page_va, wimg_flags, use_default);
+	if (kr == KERN_SUCCESS) {
+		vm_object_t obj = VME_OBJECT(entry);
+		vm_object_lock(obj);
+		obj->set_cache_attr = TRUE;
+		vm_object_unlock(obj);
+	}
+	vm_map_found_entry_ex_unlock(ctx, &orig_map);
+	return kr;
+}
+
+void
+linux64_el0_release_autowire_range(
+	vm_map_t                map,
+	mach_vm_address_t       addr,
+	mach_vm_size_t          len)
+{
+	if (!linux64_el0 || map == VM_MAP_NULL || map->pmap != kernel_pmap || len == 0) {
+		return;
+	}
+	vm_map_offset_t map_mask = VM_MAP_PAGE_MASK(map);
+	vm_map_offset_t start = vm_map_trunc_page(addr, map_mask);
+	vm_map_offset_t end_raw = 0;
+	if (os_add_overflow(addr, len, &end_raw)) {
+		return;
+	}
+	vm_map_offset_t end = vm_map_round_page(end_raw, map_mask);
+	if (end <= start) {
+		return;
+	}
+
+	VM_MAP_LOCK_CTX_DECLARE(ctx);
+	vm_map_t cur_map = map;
+	kern_return_t kr = vm_map_range_ex_lock(ctx, &cur_map, start, end, VMRL_EX_STREAM);
+	if (kr != KERN_SUCCESS) {
+		return;
+	}
+	vm_map_entry_t entry;
+	while ((entry = vm_map_range_next_with_error(ctx, &kr))) {
+		if (!VME_IS_SENTINEL(entry) && !entry->is_sub_map &&
+		    entry->vme_el0_autowire) {
+			entry->vme_el0_autowire = 0;
+			if (vm_map_wire_count_sub(ctx->vmlc_map, entry, FALSE)) {
+				entry->zero_wired_pages = FALSE;
+				vm_fault_unwire(ctx->vmlc_map, entry, false, ctx->vmlc_map->pmap,
+				    entry->vme_start, entry->vme_end);
+			}
+		}
+	}
+	vm_map_range_ex_unlock(ctx, &cur_map);
+}
