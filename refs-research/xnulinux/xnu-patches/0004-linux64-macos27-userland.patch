diff --git a/bsd/vfs/vfs_syscalls.c b/bsd/vfs/vfs_syscalls.c
index 873eb8f..a15ea6b 100644
--- a/bsd/vfs/vfs_syscalls.c
+++ b/bsd/vfs/vfs_syscalls.c
@@ -8018,6 +8018,44 @@ chflags(__unused proc_t p, struct chflags_args *uap, __unused int32_t *retval)
 	return error;
 }
 
+/*
+ * LINUX64: fchflagsat(fd, path, flags, atflag), system call 214 in macOS 27's libsystem_kernel: chflags relative to fd
+ * (AT_FDCWD for the working directory), not following a final symlink with AT_SYMLINK_NOFOLLOW.
+ */
+int
+fchflagsat(__unused proc_t p, struct fchflagsat_args *uap, __unused int32_t *retval)
+{
+	vnode_t vp;
+	vfs_context_t ctx = vfs_context_current();
+	int error;
+	struct nameidata nd;
+
+	if (uap->atflag & ~AT_SYMLINK_NOFOLLOW) {
+		return EINVAL;
+	}
+	AUDIT_ARG(fflags, uap->flags);
+	NDINIT(&nd, LOOKUP, OP_SETATTR, ((uap->atflag & AT_SYMLINK_NOFOLLOW) ? NOFOLLOW : FOLLOW) | AUDITVNPATH1,
+	    UIO_USERSPACE, uap->path, ctx);
+	error = nameiat(&nd, uap->fd);
+	if (error) {
+		return error;
+	}
+	vp = nd.ni_vp;
+	nameidone(&nd);
+	/* chflags1 drops the vnode reference */
+	return chflags1(vp, uap->flags, ctx);
+}
+
+/*
+ * LINUX64: getumask(), system call 215 in macOS 27's libsystem_kernel: the file creation mask, unchanged.
+ */
+int
+getumask(proc_t p, __unused struct getumask_args *uap, int32_t *retval)
+{
+	*retval = p->p_fd.fd_cmask;
+	return 0;
+}
