Subject: venus: the virtgpu renderer on macOS over the xnulinux DRM bridge

In the hosted macOS of xnulinux, the GPU is the Linux host's virtio-gpu render node, reached through kexts/XnuDrm.
gpu/xnu-drm/darwin (libxnudrm: xf86drm.h, the render node's open/mmap/poll) is copied to src/virtio/vulkan/xnudrm by the
build (gpu/venus/build-darwin.sh) and compiled into the driver; syncobjs are simulated (vn_renderer_sim_syncobj).
The vtest renderer (a socket to a local virglrenderer) and VK_EXT_map_memory_placed are left out on macOS.

--- a/src/virtio/vulkan/meson.build
+++ b/src/virtio/vulkan/meson.build
@@ -124,7 +124,7 @@
 
 vn_libs = []
 
-if not with_platform_windows
+if not with_platform_windows and host_machine.system() != 'darwin'
   libvn_files += files('vn_renderer_vtest.c')
 endif
 
@@ -134,6 +134,18 @@
     'vn_renderer_virtgpu.c',
   )
   vn_deps += dep_libdrm
+elif host_machine.system() == 'darwin'
+  # the hosted macOS of xnulinux: the Linux host's virtio-gpu render node through kexts/XnuDrm (libxnudrm, xnudrm/)
+  libvn_files += files(
+    'vn_renderer_sim_syncobj.c',
+    'vn_renderer_virtgpu.c',
+    'xnudrm/xnudrm.c',
+  )
+  vn_incs += include_directories('xnudrm')
+  vn_c_args += ['-DVN_XNUDRM', '-include', meson.current_source_dir() / 'xnudrm' / 'xnudrm_compat.h']
+  # the runtime's entrypoint tables name weak symbols venus does not define (ELF leaves them NULL): the same on Mach-O;
+  # dead-stripping drops the runtime code venus never calls (as --gc-sections does on ELF), with its references
+  vn_link_args += ['-framework', 'IOKit', '-framework', 'CoreFoundation', '-Wl,-undefined,dynamic_lookup', '-Wl,-dead_strip']
 endif
 
 if with_platform_wayland or with_platform_x11 or \
