+
+/// Virtio-GPU Venus running over MoltenVK on Apple Silicon keeps `driver_id == MESA_VENUS` while
+/// resolving `underlying_driver_id()` to `MOLTENVK` (so MoltenVK's compiler/runtime workarounds
+/// stay active). Both native Honeykrisp and Venus-over-Honeykrisp (Apple vendor without
+/// `VK_EXT_fragment_shader_interlock`) keep their own identity, and native MoltenVK resolves to
+/// `MOLTENVK`.
+#[test]
+fn venus_underlying_driver_distinguishes_moltenvk_honeykrisp_and_native() {
+    use crate::device::driver_facts::defects;
+    use crate::device::{ApiVersion, DeviceDescription, DriverWorkaround, VkExtension};
+
+    // 1. Venus + MoltenVK on Apple Silicon (e.g. Virtio-GPU Venus over host MoltenVK 1.4.2).
+    let mut venus_mvk = DeviceDescription::new(ApiVersion::V1_3);
+    venus_mvk.driver_id = Some(DriverId::MESA_VENUS);
+    venus_mvk.vendor_id = 0x106b;
+    venus_mvk
+        .extensions
+        .insert(VkExtension::ExtFragmentShaderInterlock);
+    assert_eq!(venus_mvk.driver_id, Some(DriverId::MESA_VENUS));
+    assert_eq!(venus_mvk.underlying_driver_id(), Some(DriverId::MOLTENVK));
+    assert!(defects(&venus_mvk).contains(&DriverWorkaround::FunctionsInlinedAtEveryCall));
+    assert!(defects(&venus_mvk).contains(&DriverWorkaround::BothBarycentricFormsRejected));
+    assert!(!venus_mvk.interpolates_at_offset_centered());
+
+    // 2a. Venus over Honeykrisp on Apple Silicon (no VK_EXT_fragment_shader_interlock).
+    let mut venus_hk = DeviceDescription::new(ApiVersion::V1_3);
+    venus_hk.driver_id = Some(DriverId::MESA_VENUS);
+    venus_hk.vendor_id = 0x106b;
+    assert_eq!(venus_hk.driver_id, Some(DriverId::MESA_VENUS));
+    assert_eq!(venus_hk.underlying_driver_id(), Some(DriverId::MESA_VENUS));
+    assert!(!defects(&venus_hk).contains(&DriverWorkaround::FunctionsInlinedAtEveryCall));
+    assert!(venus_hk.interpolates_at_offset_centered());
+
+    // 2b. Native Honeykrisp on Apple Silicon.
+    let mut native_hk = DeviceDescription::new(ApiVersion::V1_3);
+    native_hk.driver_id = Some(DriverId::MESA_HONEYKRISP);
+    native_hk.vendor_id = 0x106b;
+    assert_eq!(native_hk.driver_id, Some(DriverId::MESA_HONEYKRISP));
+    assert_eq!(
+        native_hk.underlying_driver_id(),
+        Some(DriverId::MESA_HONEYKRISP)
+    );
+    assert!(!defects(&native_hk).contains(&DriverWorkaround::FunctionsInlinedAtEveryCall));
+    assert!(native_hk.interpolates_at_offset_centered());
+
+    // 3. Native MoltenVK on Apple Silicon.
+    let mut native_mvk = DeviceDescription::new(ApiVersion::V1_3);
+    native_mvk.driver_id = Some(DriverId::MOLTENVK);
+    native_mvk.vendor_id = 0x106b;
+    native_mvk
+        .extensions
+        .insert(VkExtension::ExtFragmentShaderInterlock);
+    assert_eq!(native_mvk.driver_id, Some(DriverId::MOLTENVK));
+    assert_eq!(native_mvk.underlying_driver_id(), Some(DriverId::MOLTENVK));
+    assert!(defects(&native_mvk).contains(&DriverWorkaround::FunctionsInlinedAtEveryCall));
+    assert!(!native_mvk.interpolates_at_offset_centered());
+}
