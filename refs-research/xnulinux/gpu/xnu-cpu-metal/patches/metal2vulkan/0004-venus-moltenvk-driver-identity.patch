+    ///   returns `Some(DriverId::MOLTENVK)` (unless `XNU_CPU_METAL_VENUS_HOST_DRIVER=raw`).
+    /// - Otherwise returns `self.driver_id`.
+    pub fn underlying_driver_id(&self) -> Option<vk::DriverId> {
+        const APPLE_VENDOR_ID: u32 = 0x106b;
