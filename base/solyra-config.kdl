// Solyra OS — session config for solyra-comp (our niri fork).
//
// Look: calm warm-neutral surfaces, flat fills and hairlines, one muted accent
// that only marks the active thing. Overlays (launcher, control centre, agent
// card) are faintly translucent over a blurred wallpaper; the bar and dock are
// nearly opaque. See docs/design-language.md.

input {
    keyboard {
        numlock
    }
    touchpad {
        tap
        natural-scroll
    }
    mouse {
        accel-profile "flat"
    }
}

environment {
    LANG "C.UTF-8"
    GTK_THEME "Adwaita:dark"
    XDG_CURRENT_DESKTOP "Solyra"
    QT_QPA_PLATFORM "wayland"
    MOZ_ENABLE_WAYLAND "1"
}

// Compositor-wide backdrop blur, used by the shell's layer rules below.
// macOS 26 Liquid Glass frost: shapes behind glass soften into colour but
// stay legible as shapes (the lensing at the rim is what reads as glass).
blur {
    passes 3
    offset 3.0
    noise 0.02
    saturation 1.0
}

// Windows draw their own (client-side) decorations only if the app insists.
prefer-no-csd

layout {
    gaps 12
    center-focused-column "on-overflow"
    // New windows take half the screen; Mod+R cycles one third, half, two thirds.
    default-column-width { proportion 0.5; }
    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }
    preset-window-heights {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
        proportion 1.0
    }
    background-color "#121016"
    focus-ring { off; }
    // pearOS window frame (FIGMA spec): a 1 px white 20 % rim and a deep,
    // soft shadow (0 18 54 at 57 %); no coloured focus border.
    border {
        width 1
        active-color "#ffffff33"
        inactive-color "#ffffff1a"
    }
    shadow {
        on
        softness 54
        spread 0
        offset x=0 y=18
        color "#00000091"
        inactive-color "#00000060"
    }
    struts {
        left 8
        right 8
        top 8
        bottom 8
    }
}

overview {
    backdrop-color "#121016"
}

screenshot-path "~/Pictures/Screenshots/Screenshot from %Y-%m-%d %H-%M-%S.png"

hotkey-overlay {
    skip-at-startup
}

// Small helper windows float, centred, so they never reshuffle your columns.
window-rule {
    match app-id="^xdg-desktop-portal-gtk$"
    match app-id="^polkit-gnome-authentication-agent-1$"
    match app-id="^(org\\.gnome\\.)?(Calculator|FileRoller)$"
    match app-id="^galculator$"
    open-floating true
}

// Windows owned by an agent (app id solyra-agent-*) are marked with the agent
// colour, so it is always clear what an agent opened.
window-rule {
    match app-id="^solyra-agent-"
    border {
        width 2
        active-color "#ff9f0a"
        inactive-color "#ff9f0a99"
    }
}

window-rule {
    match app-id="firefox$" title="^Picture-in-Picture$"
    open-floating true
}

window-rule {
    match title="^Settings$"
    default-column-width { fixed 900; }
    default-window-height { fixed 620; }
    open-floating true
}

window-rule {
    geometry-corner-radius 16
    clip-to-geometry true
    // Translucent apps (the terminal) get the same glass treatment as chrome.
    background-effect {
        blur true
        xray false
    }
}

// --- shell surfaces -------------------------------------------------------
// Each surface gets its own blur + shadow + radius, so the compositor clips
// the effect to the rounded shape instead of a rectangle.

// The bar, dock and notch blur only when their material asks for it: the
// panel sends the exact shape with ext-background-effect (Glass, Acrylic) or
// nothing (Solid, See-through). The namespace ends in the material's name.
layer-rule {
    match namespace=r#"^solyra-bar(\..+)?$"#
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace=r#"^solyra-dock(\..+)?$"#
    // macOS 26 dock: Liquid Glass. The backdrop is blurred and bent at the
    // rim (refraction, Solyra's lensing in the blur shader).
    geometry-corner-radius 22
    background-effect {
        xray false
        // Material preset: clear glass (light frost, strong lensing).
        blur-passes 2
        blur-offset 2.5
        refraction 11
        refraction-radius 22
    }
}

layer-rule {
    match namespace=r#"^solyra-desk(\..+)?$"#
    geometry-corner-radius 24
    shadow {
        on
        softness 40
        spread 8
        offset x=0 y=12
        color "#00000080"
    }
    background-effect {
        xray false
    }
}

// Desktop widgets: blur behind each card (the panel sends the card shapes).
layer-rule {
    match namespace="^solyra-widgets$"
    background-effect {
        xray false
    }
}

layer-rule {
    match namespace=r#"^solyra-(taskbar|dock-magnify|dock-hidden|notch)(\..+)?$"#
    background-effect {
        xray false
    }
}

// solyra-web (Tauri + React shell): transparent surfaces whose cards send
// their exact rounded boxes over solyra_glass_v1, which clips this blur to
// them. The notch is opaque black and needs none.
layer-rule {
    match namespace=r#"^solyra-web-(dock|spotlight|control)$"#
    background-effect {
        blur true
        xray false
        blur-passes 2
        blur-offset 2.5
        refraction 11
        refraction-radius 24
        saturation 1.35
    }
}

// Materials. Glass: clean blur with a little extra colour. Acrylic: a softer
// colour lift plus fine grain (the panel adds the wallpaper-tinted layer).
layer-rule {
    match namespace=r#"\.glass$"#
    background-effect {
        saturation 1.35
        noise 0.0
    }
}

layer-rule {
    match namespace=r#"\.acrylic$"#
    background-effect {
        saturation 1.15
        noise 0.06
    }
}

// Accessibility glass scales from Settings / the panel (protocol v2 is the
// live path; this file is watched so blur-passes and refraction update too).
include "~/.config/solyra/glass.kdl" optional=true

// Spotlight is a capsule and a results card on one transparent surface. The
// panel paints their shadow and asks for blur behind just those two shapes
// (ext-background-effect), so the rule must not blur or shadow the whole surface.
// Spotlight inside the island: smoked glass like the notch it grows from.
layer-rule {
    match namespace="^solyra-launcher-island$"
    background-effect {
        xray false
        refraction 12
        refraction-radius 26
        saturation 1.8
    }
}

layer-rule {
    match namespace="^solyra-launcher$"
    background-effect {
        xray false
        refraction 10
        refraction-radius 28
        saturation 1.2
    }
}

layer-rule {
    match namespace="^solyra-control$"
    geometry-corner-radius 20
    shadow {
        on
        softness 50
        spread 12
        offset x=0 y=12
        color "#000000a0"
    }
    background-effect {
        blur true
        xray false
        refraction 10
        refraction-radius 20
    }
}

layer-rule {
    match namespace="^solyra-menu$"
    background-effect {
        blur true
        xray false
        refraction 9
        refraction-radius 10
    }
}

layer-rule {
    match namespace="^solyra-notifs$"
    geometry-corner-radius 20
    background-effect {
        blur true
        xray false
        refraction 8
        refraction-radius 20
    }
}

layer-rule {
    match namespace="^solyra-agents$"
    geometry-corner-radius 22
    shadow {
        on
        softness 50
        spread 12
        offset x=0 y=12
        color "#000000a0"
    }
    background-effect {
        blur true
        xray false
    }
}

layer-rule {
    match namespace="^solyra-island$"
    geometry-corner-radius 22
    shadow {
        on
        softness 44
        spread 10
        offset x=0 y=12
        color "#000000a0"
    }
    background-effect {
        blur true
        xray false
    }
}

animations {
    window-open {
        duration-ms 180
        curve "ease-out-expo"
    }
    window-close {
        duration-ms 150
        curve "ease-out-expo"
    }
    window-movement {
        duration-ms 120
        curve "ease-out-expo"
    }
}

// The shell: bar, dock, island. Clients, so killing one never takes the
// session down; the compositor respawns nothing.
spawn-at-startup "swaybg" "-i" "/usr/share/solyra/wallpapers/silk.png" "-m" "fill"
spawn-at-startup "/usr/libexec/polkit-gnome-authentication-agent-1"
spawn-at-startup "solyra-panel"

binds {
    Mod+Shift+Slash { show-hotkey-overlay; }

    // Shell.
    Mod+D hotkey-overlay-title="Open the Launcher" { spawn "solyra-panel" "toggle-launcher"; }
    Mod+Space hotkey-overlay-title="Open the Launcher" { spawn "solyra-panel" "toggle-launcher"; }
    Mod+Shift+C hotkey-overlay-title="Control Centre" { spawn "solyra-panel" "toggle-control"; }
    Mod+Shift+I hotkey-overlay-title="Dynamic Island" { spawn "solyra-panel" "toggle-island"; }
    Mod+Shift+A hotkey-overlay-title="Agent tasks" { spawn "solyra-panel" "toggle-agents"; }
    // Agent Space (docs/agent-platform.md): workspace 7, apart from your own.
    Mod+A hotkey-overlay-title="Agent Space" { focus-workspace 7; }
    Mod+Shift+Return hotkey-overlay-title="Terminal in the Agent Space" { spawn "solyra-agent-space"; }

    // Sessions.
    Mod+Shift+E { quit; }
    // Solyra's lock screen; swaylock if it cannot start.
    Mod+Ctrl+L hotkey-overlay-title="Lock the Screen" { spawn-sh "solyra-panel lock || swaylock"; }
    // Recovery: if a lock screen ever dies, the session stays locked; this
    // starts swaylock on top so you can still unlock.
    Mod+Alt+L allow-when-locked=true { spawn "swaylock"; }

    // These read Settings -> Default apps; the original app is the fallback.
    Mod+Return hotkey-overlay-title="Open a Terminal" {
        spawn "solyra-open" "terminal";
    }
    Mod+B hotkey-overlay-title="Open the Browser" {
        spawn "solyra-open" "browser";
    }
    Mod+E hotkey-overlay-title="Open Files" {
        spawn "solyra-open" "files";
    }
    Mod+S hotkey-overlay-title="Settings" { spawn "solyra-settings"; }

    // Window management: niri's scrollable columns.
    Mod+Left  { focus-column-left; }
    Mod+Down  { focus-window-down; }
    Mod+Up    { focus-window-up; }
    Mod+Right { focus-column-right; }
    Mod+H     { focus-column-left; }
    Mod+J     { focus-window-down; }
    Mod+K     { focus-window-up; }
    Mod+L     { focus-column-right; }

    Mod+Shift+Left  { move-column-left; }
    Mod+Shift+Down  { move-window-down; }
    Mod+Shift+Up    { move-window-up; }
    Mod+Shift+Right { move-column-right; }
    Mod+Shift+H     { move-column-left; }
    Mod+Shift+J     { move-window-down; }
    Mod+Shift+K     { move-window-up; }
    Mod+Shift+L     { move-column-right; }

    Mod+Comma  { consume-window-into-column; }
    Mod+Period { expel-window-from-column; }

    // Snap Assist: sizes and places for tidy windows.
    Mod+R { switch-preset-column-width; }
    Mod+Shift+R { switch-preset-window-height; }
    Mod+V { toggle-window-floating; }
    Mod+Shift+V { switch-focus-between-floating-and-tiling; }
    Mod+Ctrl+Left  { move-column-to-monitor-left; }
    Mod+Ctrl+Right { move-column-to-monitor-right; }
    Mod+Ctrl+Up    { move-column-to-monitor-up; }
    Mod+Ctrl+Down  { move-column-to-monitor-down; }

    Mod+F { maximize-column; }
    Mod+Shift+F { fullscreen-window; }
    Mod+C { center-column; }
    Mod+W { close-window; }

    Mod+Minus { set-column-width "-10%"; }
    Mod+Equal { set-column-width "+10%"; }

    // Workspaces 1-9 + overview. 7-9 are the Agent Space.
    Mod+1 { focus-workspace 1; }
    Mod+2 { focus-workspace 2; }
    Mod+3 { focus-workspace 3; }
    Mod+4 { focus-workspace 4; }
    Mod+5 { focus-workspace 5; }
    Mod+6 { focus-workspace 6; }
    Mod+7 { focus-workspace 7; }
    Mod+8 { focus-workspace 8; }
    Mod+9 { focus-workspace 9; }
    Mod+Tab { toggle-overview; }

    // Screenshots.
    Print { screenshot; }
    Ctrl+Print { screenshot-screen; }
    Alt+Print { screenshot-window; }

    // Media and volume keys.
    // Volume, brightness and media keys show a HUD in the notch (Droppy-style).
    XF86AudioRaiseVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05+ -l 1.0; solyra-panel hud volume"; }
    XF86AudioLowerVolume allow-when-locked=true { spawn-sh "wpctl set-volume @DEFAULT_AUDIO_SINK@ 0.05-; solyra-panel hud volume"; }
    XF86AudioMute        allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle; solyra-panel hud volume"; }
    XF86AudioMicMute     allow-when-locked=true { spawn-sh "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle"; }
    XF86MonBrightnessUp   allow-when-locked=true { spawn-sh "brightnessctl -q set 5%+; solyra-panel hud brightness"; }
    XF86MonBrightnessDown allow-when-locked=true { spawn-sh "brightnessctl -q set 5%-; solyra-panel hud brightness"; }
    XF86AudioPlay        allow-when-locked=true { spawn "solyra-panel" "media" "play-pause"; }
    XF86AudioPause       allow-when-locked=true { spawn "solyra-panel" "media" "play-pause"; }
    XF86AudioNext        allow-when-locked=true { spawn "solyra-panel" "media" "next"; }
    XF86AudioPrev        allow-when-locked=true { spawn "solyra-panel" "media" "previous"; }
}
