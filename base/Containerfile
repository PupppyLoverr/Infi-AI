# Solyra OS base image — Fedora Atomic (bootc).
#
# P2 scope (PLAN.md §4): a minimal bootable base and niri session.
#
# Build:  sudo docker build -f base/Containerfile -t solyra-base:dev .
# (context is the repo root: the compositor binary comes from comp/out/)
# Measured every milestone (docs/budgets-legacy.md discipline): see base/README.md
FROM quay.io/fedora/fedora-bootc:46

# --- essentials only --------------------------------------------------------
# NetworkManager + polkit: wired up in the v1-v6 image and needed by every
# tray/agent later. openssh-server: the drive harness reaches the guest over
# QEMU until the harness is rewired (tests/drive/README.md).
RUN dnf -y install \
      NetworkManager \
      polkit \
      sudo \
      openssh-server \
 && dnf -y clean all

# --- compositor runtime (solyra-comp, forked niri) ---------------------------
# Libraries the vendored niri links against; the binary itself is COPYd in
# from comp/out/niri (built in comp/dev.Containerfile). mesa-dri-drivers
# gives llvmpipe so software GL works in VMs and on no-GPU hardware.
# dbus-tools lets the session import WAYLAND_DISPLAY/DISPLAY into the user
# manager; xwayland-satellite gives X11 apps a display without Xorg.
RUN dnf -y install \
      libinput libxkbcommon libseat libdisplay-info libwayland-server \
      mesa-libgbm mesa-libEGL mesa-dri-drivers libglvnd \
      pipewire-libs pango cairo-gobject \
      dbus-broker dbus-tools udisks2 xwayland-satellite \
      foot fuzzel thunar swaylock swaybg dejavu-sans-mono-fonts \
 && dnf -y clean all

# --- everyday desktop -------------------------------------------------------
# A usable system, not just a compositor: login manager, audio, networking
# tools, a browser and an editor. Sizes are measured in CI (budget <= 4 GB).
#   greetd + agreety  text login; the dev disk adds an autologin initial_session
#   wireplumber       `wpctl`, which the control centre volume slider drives
#   NetworkManager-tui  `nmtui`, opened from the control centre network tile
RUN dnf -y install \
      greetd \
      wireplumber pipewire-pulseaudio pipewire-alsa \
      NetworkManager-wifi NetworkManager-tui \
      brightnessctl \
      firefox mousepad ristretto galculator wtype \
      rsms-inter-fonts adwaita-icon-theme \
      xdg-desktop-portal-gtk gvfs \
      mesa-vulkan-drivers vulkan-loader fontconfig \
      bubblewrap webkit2gtk4.1 \
      open-vm-tools \
 && dnf -y clean all
# VMware guest services (time sync, clean shutdown, guest info). The unit only
# starts on VMware (ConditionVirtualization), so it costs nothing elsewhere.
RUN systemctl enable vmtoolsd.service
# Optional pieces: skipped with a visible note rather than failing the build.
RUN dnf -y install --skip-unavailable polkit-gnome 2>&1 | tail -3 ; dnf -y clean all

# --- identity ----------------------------------------------------------------
# Solyra's own identity lives in the image so every boot (disk, ISO, VM)
# reports it. Codename "Perihelion" tracks PLAN.md.
RUN printf '%s\n' \
      'NAME="Solyra OS"' \
      'VERSION="0.1 (Perihelion)"' \
      'ID=solyra' \
      'ID_LIKE=fedora' \
      'VERSION_ID=0.1' \
      'PLATFORM_ID="platform:f46"' \
      'PRETTY_NAME="Solyra OS 0.1 (Perihelion)"' \
      'ANSI_COLOR="0;38;2;60;110;180"' \
      'HOME_URL="https://github.com/pupppyloverr/infi-ai"' \
      'SUPPORT_URL="https://github.com/pupppyloverr/infi-ai/issues"' \
      > /usr/lib/os-release
RUN mkdir -p /usr/etc && \
    printf 'Solyra OS 0.1 (Perihelion) \\n \\l\n\n' > /usr/etc/issue

# --- default user -----------------------------------------------------------
# Provisioned via sysusers (bootc-friendly: no layer-time account state).
# The first-boot setup wizard (P6) takes over real account setup later.
COPY base/sysusers.d/10-solyra.conf /usr/lib/sysusers.d/10-solyra.conf
COPY base/sudoers.d/solyra /etc/sudoers.d/solyra
RUN systemd-sysusers --dry-run /usr/lib/sysusers.d/10-solyra.conf

# --- compositor and shell -----------------------------------------------------
# Both are built in the dev container (comp/dev.Containerfile) and dropped at
# comp/out/niri and shell/out/solyra-panel. Two names for the compositor:
# solyra-comp is the real binary, niri stays an alias so stock docs work.
# The panel (bar, notch, dock, launcher, lock screen) is started by the
# session config: spawn-at-startup "solyra-panel" in solyra-config.kdl.
COPY comp/out/niri /usr/bin/solyra-comp
COPY base/solyra-session /usr/bin/solyra-session
COPY base/solyra-open /usr/bin/solyra-open
COPY base/solyra-agent-space /usr/bin/solyra-agent-space
COPY shell/out/solyra-panel /usr/bin/solyra-panel
# zgx apps (apps/): built in CI by the dev container into apps/out/.
COPY apps/out/solyra-settings /usr/bin/solyra-settings
COPY apps/out/solyra-browse /usr/bin/solyra-browse
COPY apps/out/solyra-files /usr/bin/solyra-files
# First-boot setup (experimental): wizard, root helper, units. See docs/setup.md.
COPY apps/out/solyra-setup /usr/bin/solyra-setup
COPY apps/out/solyra-setup-apply /usr/bin/solyra-setup-apply
COPY base/solyra-install /usr/bin/solyra-install
COPY base/systemd/ /usr/lib/systemd/system/
COPY base/tmpfiles.d/solyra-setup.conf /usr/lib/tmpfiles.d/solyra-setup.conf
RUN systemctl enable solyra-setup-apply.path
# Agent runtime pieces (agent/): hooks, terminal wrapper, level-1 sandbox.
COPY apps/out/solyra-agent /usr/bin/solyra-agent
COPY base/profile.d/solyra-agent.sh /etc/profile.d/solyra-agent.sh
COPY base/applications/ /usr/share/applications/
RUN ln -s solyra-comp /usr/bin/niri
COPY assets/wallpapers/silk-1920x1080.png /usr/share/solyra/wallpapers/silk.png
COPY assets/wallpapers/silk-light-1920x1080.png /usr/share/solyra/wallpapers/silk-light.png
COPY assets/wallpapers/beach-1920x1080.png /usr/share/solyra/wallpapers/beach.png
COPY assets/wallpapers/violet-1920x1080.png /usr/share/solyra/wallpapers/violet.png
COPY assets/wallpapers/ocean-1920x1080.png /usr/share/solyra/wallpapers/ocean.png
COPY assets/wallpapers/sunset-1920x1080.png /usr/share/solyra/wallpapers/sunset.png
COPY assets/wallpapers/forest-1920x1080.png /usr/share/solyra/wallpapers/forest.png
COPY assets/wallpapers/graphite-1920x1080.png /usr/share/solyra/wallpapers/graphite.png
COPY base/theme/foot.ini /etc/xdg/foot/foot.ini
COPY base/theme/gtk-3.0/settings.ini /etc/gtk-3.0/settings.ini
COPY base/theme/gtk-4.0/settings.ini /etc/gtk-4.0/settings.ini
COPY base/solyra-config.kdl /etc/solyra/comp.kdl
COPY base/greetd.toml /etc/greetd/config.toml
COPY base/pam.d/solyra-lock /etc/pam.d/solyra-lock
# Log in on tty1 through greetd; the compositor session starts after login.
RUN systemctl enable greetd.service && systemctl set-default graphical.target
COPY base/solyra.desktop /usr/share/wayland-sessions/solyra.desktop
RUN /usr/bin/solyra-comp validate -c /etc/solyra/comp.kdl

# --- trim -------------------------------------------------------------------
# Locale clutter and docs trees are the cheapest GBs. Package set review and
# the real size measurement are the P1 gate (PLAN.md §7).
RUN rm -rf /usr/share/locale/*/ /usr/share/man/*/ /usr/share/doc/* && \
    rm -rf /var/cache/* /var/log/*
