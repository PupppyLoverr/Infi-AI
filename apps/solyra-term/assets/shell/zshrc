# Solyra Terminal shell integration for zsh (loaded through ZDOTDIR).
ZDOTDIR="$HOME"
[ -f "$HOME/.zshrc" ] && . "$HOME/.zshrc"
__solyra_precmd() { local s=$?; printf '\e]133;D;%s\e\\' "$s"; printf '\e]7;file://%s%s\e\\' "${HOST:-localhost}" "$PWD"; }
autoload -Uz add-zsh-hook 2>/dev/null && add-zsh-hook precmd __solyra_precmd
if [ -z "$SOLYRA_KEEP_PROMPT" ] && [ -z "$ZSH_THEME" ]; then
  PROMPT=$'%{\e]133;A\e\\%}%B%F{green}➜%f%b  %B%F{cyan}%1~%f%b %{\e]133;B\e\\%}'
fi
